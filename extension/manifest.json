{
  "manifest_version": 3,
  "name": "Knowvia \u2014 Capture knowledge",
  "version": "2.2.0",
  "description": "Capture knowledge. Turn it into action. Save articles, selections, and notes to Knowvia and your connected TickTick lists.",
  "permissions": [
    "activeTab",
    "storage",
    "identity",
    "tabs",
    "contextMenus",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://lionfish-app-jxpvk.ondigitalocean.app/*",
    "https://accounts.google.com/*",
    "https://ticktick.com/*",
    "https://api.ticktick.com/*",
    "https://t.me/*",
    "https://telegram.me/*",
    "<all_urls>",
    "http://localhost:3000/*"
  ],
  "action": {
    "default_title": "Capture with Knowvia",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "oauth2": {
    "client_id": "YOUR_GOOGLE_CLIENT_ID_IF_NEEDED",
    "scopes": []
  }
}
