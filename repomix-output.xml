            STORAGE_KEYS.legacyUserId, STORAGE_KEYS.legacyToken, STORAGE_KEYS.ticktickConnected]);
        return { ...resolveAuthState(stored), session: stored[STORAGE_KEYS.token] || stored[STORAGE_KEYS.legacyToken] || "" };
