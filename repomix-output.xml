<file path="utils/notionApi.js">
import notionCredentials from "../services/notionCredentials.js";
import
{
    getNotionLinkConfig
}
from "./notionLinkOAuth.js";
import
{
    notionFailure,
    notionErrors
}
from "./notionErrors.js";
import
{
    notionId
}
from "../validators/notionValidator.js";

export const NOTION_REQUEST_BYTES = 480000; // Headroom below the documented 500KB.
const RESPONSE_BYTES = 2 * 1024 * 1024;
const uuidPath = "[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}";
const routes = {
    GET: new RegExp(`^/(pages|data_sources|databases)/${uuidPath}$`),
    POST: /^\/(search|pages)$/,
    PATCH: new RegExp(`^/blocks/${uuidPath}/children$`)
};

const boundedJson = async response =>
{
    if (!/^application\/json\b/i.test(response.headers.get("content-type") || "") || !response.body)
    {
        await response.body?.cancel();
        throw notionFailure("NOTION_INVALID_RESPONSE");
    }
    const reader = response.body.getReader();
    const chunks = [];
    let size = 0;
    try
    {
        while (true)
        {
            const
            {
                done,
                value
            } = await reader.read();
            if (done) break;
            size += value.byteLength;
            if (size > RESPONSE_BYTES)
            {
                await reader.cancel();
                throw notionFailure("NOTION_INVALID_RESPONSE");
            }
            chunks.push(Buffer.from(value));
        }
        const data = JSON.parse(Buffer.concat(chunks).toString("utf8"));
        if (!data || typeof data !== "object" || Array.isArray(data)) throw new Error();
        return data;
    }
    catch
    {
        throw notionFailure("NOTION_INVALID_RESPONSE");
    }
    finally
    {
        reader.releaseLock();
    }
};

export const createNotionApiClient = (
{
    credentials = notionCredentials,
    getConfig = getNotionLinkConfig,
    fetchImpl = (...args) => fetch(...args)
} = {}) =>
{
    const request = async (
    {
        userId,
        method,
        path,
        body,
        connection: expectedConnection,
        deadline
    } = {}) =>
    {
        if (!routes[method]?.test(path || "")) throw notionFailure("INVALID_NOTION_INPUT");
        const mutating = method === "PATCH" || (method === "POST" && path === "/pages");
        const serialized = body === undefined ? undefined : JSON.stringify(body);
        if (serialized && Buffer.byteLength(serialized) > NOTION_REQUEST_BYTES) throw notionFailure("NOTION_CONTENT_LIMIT");
        const config = getConfig();
        let snapshot = await credentials.getForUser(
        {
            userId,
            expectedConnection
        });
        // Bind even a caller's first request to the identity it actually read.
        const binding = expectedConnection || snapshot.connection;
        const perform = async current =>
        {
            const remaining = deadline === undefined ? 10000 : Math.min(10000, deadline - Date.now());
            if (remaining <= 0) throw notionFailure("NOTION_PROVIDER_UNAVAILABLE");
            let response;
            try
            {
                response = await fetchImpl(`https://api.notion.com/v1${path}`,
                {
                    method,
                    redirect: "error",
                    signal: AbortSignal.timeout(remaining),
                    headers:
                    {
                        Authorization: `Bearer ${current.accessToken}`,
                        "Notion-Version": config.apiVersion,
                        Accept: "application/json",
                        ...(serialized === undefined ?
                        {} :
                        {
                            "Content-Type": "application/json"
                        })
                    },
                    ...(serialized === undefined ?
                    {} :
                    {
                        body: serialized
                    })
                });
            }
            catch
            {
                throw notionFailure("NOTION_PROVIDER_UNAVAILABLE",
                {
                    ambiguous: mutating
                });
            }
            if (response.status >= 200 && response.status < 300)
            {
                try
                {
                    return {
                        data: await boundedJson(response),
                        connection: current.connection
                    };
                }
                catch
                {
                    throw notionFailure("NOTION_INVALID_RESPONSE",
                    {
                        ambiguous: mutating
                    });
                }
            }
            if (response.status === 401)
            {
                await response.body?.cancel();
                throw Object.assign(notionFailure("NOTION_RECONNECT_REQUIRED"),
                {
                    unauthorized: true
                });
            }
            const retryHeader = response.headers.get("retry-after");
            const retryAfter = /^\d{1,7}$/.test(retryHeader || "") ? Number(retryHeader) : undefined;
            // A failed write may have committed. Retain only an explicitly
            // reported UUID, never the raw response or provider error message.
            let resourceId;
            try
            {
                resourceId = notionId((await boundedJson(response)).additional_data?.committed_resource_id);
            }
            catch
            {
                /* The HTTP status remains authoritative for rejected requests. */
            }
            const code = response.status === 403 ? "NOTION_PERMISSION_DENIED" :
                response.status === 404 ? "NOTION_RESOURCE_NOT_FOUND" :
                response.status === 429 ? "NOTION_RATE_LIMITED" :
                response.status >= 500 ? "NOTION_PROVIDER_UNAVAILABLE" : "NOTION_INVALID_REQUEST";
            throw notionFailure(code,
            {
                retryAfter,
                resourceId,
                ambiguous: mutating && Boolean(resourceId || response.status >= 500 && response.status !== 529 || response.status >= 300 && response.status < 400)
            });
        };
        try
        {
            return await perform(snapshot);
        }
        catch (error)
        {
            if (!error.unauthorized) throw error;
            try
            {
                const current = await credentials.getForUser(
                {
                    userId,
                    expectedConnection: binding
                });
                // Another completed refresh must not cause a second rotation.
                if (current.connection.credentialVersion === snapshot.connection.credentialVersion)
                    await credentials.refreshForUser(
                    {
                        userId
                    });
                snapshot = await credentials.getForUser(
                {
                    userId,
                    expectedConnection: binding
                });
            }
            catch (refreshError)
            {
                if (refreshError?.code === "NOTION_REFRESH_UNAVAILABLE") throw notionFailure("NOTION_REFRESH_UNAVAILABLE");
                if (["NOTION_REFRESH_SUPERSEDED", "NOTION_CONNECTION_CHANGED"].includes(refreshError?.code))
                    throw notionFailure("NOTION_CONNECTION_CHANGED");
                if (Object.hasOwn(notionErrors, refreshError?.code || "") && refreshError.code !== "NOTION_RECONNECT_REQUIRED")
                    throw notionFailure(refreshError.code);
                throw notionFailure("NOTION_RECONNECT_REQUIRED");
            }
            try
            {
                return await perform(snapshot);
            }
            catch (retryError)
            {
                if (retryError.unauthorized)
                {
                    try
                    {
                        await credentials.markRejectedForUser(
                        {
                            userId,
                            connection: snapshot.connection
                        });
                    }
                    catch
                    {
                        /* Never overwrite a newer connection or expose persistence details. */
                    }
                    throw notionFailure("NOTION_RECONNECT_REQUIRED");
                }
                throw retryError;
            }
        }
    };
    return {
        request
    };
};

export default createNotionApiClient();
</file>

<file path="utils/notionContentBlocks.js">
import
{
    createHash
}
from "node:crypto";
import
{
    notionFailure
}
from "./notionErrors.js";
import
{
    NOTION_REQUEST_BYTES
}
from "./notionApi.js";

export const splitNotionText = text =>
{
    const chunks = [];
    for (let offset = 0; offset < text.length;)
    {
        let end = Math.min(offset + 2000, text.length);
        if (end < text.length && /[\uD800-\uDBFF]/.test(text[end - 1])) end--;
        chunks.push(text.slice(offset, end));
        offset = end;
    }
    return chunks;
};
const richText = text => (
{
    type: "text",
    text:
    {
        content: text
    }
});
const paragraph = text => (
{
    object: "block",
    type: "paragraph",
    paragraph:
    {
        rich_text: [richText(text)]
    }
});
const heading = text => (
{
    object: "block",
    type: "heading_2",
    heading_2:
    {
        rich_text: [richText(text)]
    }
});
const validateText = value =>
{
    if (typeof value !== "string" || !value.isWellFormed() || value.includes("\0")) throw notionFailure("NOTION_INVALID_CONTENT");
    return value.replaceAll("\r\n", "\n");
};

export const mapNotionContent = content =>
{
    const title = validateText(content.title || "Saved knowledge").trim();
    const rawText = validateText(content.rawText).trim();
    const summary = content.summary == null ? "" : validateText(content.summary).trim();
    if (!title || !rawText || (content.tags != null && !Array.isArray(content.tags))) throw notionFailure("NOTION_INVALID_CONTENT");
    const tags = (content.tags || []).map(value => validateText(value).trim()).filter(Boolean);
    if (title.length > 500 || title.length + rawText.length + summary.length + tags.join(" ").length > 400000 || tags.length > 1000)
        throw notionFailure("NOTION_CONTENT_LIMIT");
    const blocks = [];
    const addParagraphs = text =>
    {
        for (const part of text.split(/\n[\t ]*\n+/))
        {
            if (!part) continue;
            for (const chunk of splitNotionText(part)) blocks.push(paragraph(chunk));
        }
    };
    if (content.url)
    {
        const source = validateText(content.url);
        let url;
        try
        {
            url = new URL(source);
        }
        catch
        {
            throw notionFailure("NOTION_INVALID_CONTENT");
        }
        if (!["https:", "http:"].includes(url.protocol) || url.username || url.password) throw notionFailure("NOTION_INVALID_CONTENT");
        if (source.length > 2000) throw notionFailure("NOTION_CONTENT_LIMIT");
        blocks.push(
        {
            object: "block",
            type: "paragraph",
            paragraph:
            {
                rich_text: [richText("Source: "),
                {
                    type: "text",
                    text:
                    {
                        content: source,
                        link:
                        {
                            url: source
                        }
                    }
                }]
            }
        });
    }
    if (tags.length) addParagraphs(`Tags: ${tags.map(value => `#${value}`).join(" ")}`);
    addParagraphs(rawText);
    // contentService already appends this exact suffix when requested. Do not
    // copy the existing summary a second time into the exported body.
    const alreadyMerged = content.options?.mergeSummaryWithContent && rawText.endsWith(`Summary:\n${summary}`);
    if (summary && !alreadyMerged)
    {
        blocks.push(heading("Summary"));
        addParagraphs(summary);
    }
    if (blocks.length > 1000) throw notionFailure("NOTION_CONTENT_LIMIT");
    return {
        title: [richText(title)],
        blocks,
        contentHash: createHash("sha256").update(JSON.stringify(
        {
            title,
            blocks
        })).digest("hex")
    };
};

export const nextNotionBatch = (blocks, offset, base = {}) =>
{
    const children = [];
    for (let index = offset; index < blocks.length && children.length < 100; index++)
    {
        if (Buffer.byteLength(JSON.stringify(
            {
                ...base,
                children: [...children, blocks[index]]
            })) > NOTION_REQUEST_BYTES) break;
        children.push(blocks[index]);
    }
    if (!children.length && offset < blocks.length) throw notionFailure("NOTION_CONTENT_LIMIT");
    return children;
};
