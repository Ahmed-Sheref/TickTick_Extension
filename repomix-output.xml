/* Notion UI for the existing popup. Application JWTs stay in apiFetch; provider
   credentials never enter the extension. All persisted data here is display-only. */
(() =>
{
    const DISPLAY_KEY = "knowvia_notion_destination_display";
    const id = value => typeof value === "string" && /^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$/i.test(value) ? value.toLowerCase() : null;
    const kind = type => type === "data_source" ? "Data source" : "Page";
    const safeUrl = value =>
    {
        try
        {
            const url = new URL(value);
            return typeof value === "string" && value.length <= 2000 && url.protocol === "https:" && !url.username && !url.password && !url.port &&
                /(^|\.)(notion\.so|notion\.site|notion\.com)$/.test(url.hostname) ? url.href : null;
        }
        catch
        {
            return null;
        }
    };
    const icon = name =>
    {
        const svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
        svg.setAttribute("viewBox", "0 0 24 24");
        svg.setAttribute("aria-hidden", "true");
        svg.setAttribute("focusable", "false");
        const use = document.createElementNS(svg.namespaceURI, "use");
        use.setAttribute("href", `#icon-${name}`);
        svg.append(use);
        return svg;
    };

    const create = deps =>
    {
        const el = Object.fromEntries(["notionDestination", "notionCaptureHint", "notionStatus", "notionConnectionHint", "connectNotionBtn",
            "notionDefaultRow", "notionDefaultName", "manageNotionDestinationBtn", "notionCapabilityNote", "notionDestinationDialog", "notionSearchInput", "notionResultsCaption", "notionResultsScroll",
            "notionDestinationResults", "notionDestinationState", "notionDestinationStateTitle", "notionDestinationStateText", "notionDestinationError",
            "refreshNotionDestinationsBtn", "retryNotionDestinationsBtn", "loadMoreNotionDestinationsBtn", "clearNotionDestinationBtn",
            "cancelNotionDestinationBtn", "confirmNotionDestinationBtn", "closeNotionDialogBtn"
        ].map(key => [key, document.getElementById(key)]));
        let owner = null;
        let refreshVersion = 0;
        let searchVersion = 0;
        let access = "checking";
        let workspaceName = "";
        let selectionReady = false;
        let selectionError = "";
        let destination = null;
        let choices = [];
        let draft = null;
        let nextCursor = null;
        let loading = false;
        let mutation = false;
        let mutationVersion = 0;
        let authBlocked = false;
        let searchController;
        let searchTimer;
        let opener;
        const known = new Map();
        const same = (a, b) => Boolean(a && b && a.id === b.id && a.type === b.type);
        const blocked = () => authBlocked || deps.isBlocked();
        const current = async identity =>
        {
            const now = await deps.getOwner();
            return Boolean(identity?.isSignedIn && now.isSignedIn && now.userId === identity.userId && now.session === identity.session);
        };
        const request = async (path, options = {}, identity = owner) =>
        {
            if (!await current(identity)) throw Object.assign(new Error("Your account changed. Reopen the popup to continue."),
            {
                code: "SESSION_CHANGED"
            });
            const result = await deps.apiFetch(path, options);
            if (!await current(identity)) throw Object.assign(new Error("Your account changed. Reopen the popup to continue."),
            {
                code: "SESSION_CHANGED"
            });
            return result;
        };
        const normalize = value =>
        {
            if (!id(value?.id) || !["page", "data_source"].includes(value.type)) return null;
            return {
                id: id(value.id),
                type: value.type,
                title: typeof value.title === "string" ? value.title.trim().slice(0, 500) : "",
                url: safeUrl(value.url)
            };
        };
        const label = value => value?.title || (value ? `${kind(value.type)} selected` : "Choose a destination");
        const busyButton = (button, busy) =>
        {
            button.disabled = busy;
            if (busy) button.setAttribute("aria-busy", "true");
            else button.removeAttribute("aria-busy");
        };
        const errorText = error =>
        {
            const messages = {
                NOTION_RECONNECT_REQUIRED: "Reconnect Notion to restore access to your workspace.",
                NOTION_NOT_CONNECTED: "Connect Notion before choosing a destination.",
                NOTION_REFRESH_UNAVAILABLE: "Notion is reconnecting. Try again shortly, or reconnect from Settings.",
                NOTION_PERMISSION_DENIED: "Check that this page or database is shared with Knowvia and allows new content.",
                NOTION_RESOURCE_NOT_FOUND: "This destination is no longer available. Share it with Knowvia or choose another.",
                NOTION_SCHEMA_INVALID: "This data source needs a title field. Choose another destination or update it in Notion.",
                NOTION_CONNECTION_CHANGED: "Your Notion connection changed. Refresh and choose the destination again.",
                NOTION_RATE_LIMITED: "Notion needs a moment. Wait before trying again.",
                NOTION_PROVIDER_UNAVAILABLE: "Notion is temporarily unavailable. Your Knowvia copy is safe.",
                NOTION_LINK_UNAVAILABLE: "Notion is not available on the server yet. Your Knowvia copy is safe.",
                NOTION_DESTINATION_REQUIRED: "Choose a default Notion destination first.",
                NOTION_INVALID_RESPONSE: "The Notion response could not be confirmed. Refresh before trying again."
            };
            return messages[error.code] || error.message || "Something went wrong. Try again.";
        };
        const render = () =>
        {
            const connected = access === "connected";
            const selected = connected && selectionReady && destination;
            const reconnect = access === "reconnect";
            const checking = access === "checking";
            el.notionDestination.disabled = checking || mutation || blocked();
            el.notionDestination.classList.toggle("selected", Boolean(deps.isSelected()));
            el.notionDestination.classList.toggle("needs-attention", connected && !selectionReady || access === "error" || reconnect);
            el.notionDestination.setAttribute("aria-label", selected ? `Notion destination: ${label(destination)}. Change destination.` :
                connected ? "Choose a Notion destination" : reconnect ? "Reconnect Notion" : "Connect Notion");
            el.notionCaptureHint.textContent = checking ? "Checking connection…" : selected ? label(destination) :
                connected ? selectionReady ? "Choose a destination" : "Check destination" : reconnect ? "Reconnect workspace" :
                access === "error" ? "Check connection" : "Connect your workspace";
            el.notionDestination.setAttribute("aria-pressed", String(deps.isSelected()));
            el.notionCaptureHint.textContent = deps.isSelected() ? selected ? label(destination) : "Choose destination" : connected ? "Not selected" : el.notionCaptureHint.textContent;
            el.notionDestination.setAttribute("aria-label", deps.isSelected() ? "Disable Notion for this capture" : "Enable Notion for this capture");
            document.getElementById("notionSaveConfig").hidden = false;
            document.getElementById("notionSaveDestinationName").textContent = selected ? label(destination) : "Choose a destination";
            const workspace = document.getElementById("notionWorkspace");
            if (workspace) workspace.value = connected ? workspaceName || "Connected workspace" : checking ? "Checking…" : "Not connected";
            document.getElementById("chooseNotionSaveDestinationBtn").disabled = checking || mutation || blocked();
            el.notionCaptureHint.title = el.notionCaptureHint.textContent;
            el.notionDefaultRow.hidden = !connected;
            el.notionDefaultName.textContent = selectionReady ? label(destination) : "Destination unavailable";
            el.manageNotionDestinationBtn.textContent = destination ? "Change" : "Choose";
            el.manageNotionDestinationBtn.disabled = mutation || blocked();
            el.notionCapabilityNote.textContent = selectionError || (selected ? "This default is used only when you enable Notion for a capture." :
                connected ? "Choose a default, then enable Notion for the captures you want to send." : "Connect a workspace, then choose where your captures go.");
            el.confirmNotionDestinationBtn.disabled = !draft || mutation || blocked();
            el.confirmNotionDestinationBtn.textContent = mutation ? "Updating…" : same(draft, destination) ? "Done" : "Use destination";
            el.clearNotionDestinationBtn.hidden = !destination;
            for (const button of [el.clearNotionDestinationBtn, el.cancelNotionDestinationBtn, el.closeNotionDialogBtn]) button.disabled = mutation;
            el.notionSearchInput.disabled = mutation;
            el.refreshNotionDestinationsBtn.disabled = mutation || loading;
            el.loadMoreNotionDestinationsBtn.disabled = mutation || loading;
            el.notionDestinationResults.setAttribute("aria-busy", String(loading));
            deps.onChange?.();
        };
        const rememberDisplay = async () =>
        {
            if (destination && owner)
            {
                try
                {
                    await deps.writeLocal(DISPLAY_KEY,
                    {
                        userId: owner.userId,
                        ...destination
                    });
                }
                catch
                {
                    /* Optional display cache. */
                }
            }
        };
        const updateKnown = entries =>
        {
            for (const entry of entries) known.set(`${entry.type}:${entry.id}`, entry);
            if (destination) destination = known.get(`${destination.type}:${destination.id}`) || destination;
        };
        const renderResults = () =>
        {
            el.notionDestinationResults.replaceChildren();
            for (const value of choices)
            {
                const row = document.createElement("button");
                row.type = "button";
                row.className = "notion-result";
                row.dataset.destinationId = value.id;
                row.setAttribute("role", "option");
                row.setAttribute("aria-selected", String(same(value, draft)));
                row.tabIndex = same(value, draft) || (!draft && value === choices[0]) ? 0 : -1;
                row.disabled = mutation;
                const mark = document.createElement("span");
                mark.className = "notion-result-icon";
                mark.append(icon(value.type === "page" ? "document" : "data-source"));
                const copy = document.createElement("span");
                copy.className = "notion-result-copy";
                const title = document.createElement("strong");
                title.dir = "auto";
                title.textContent = value.title || `Untitled ${kind(value.type).toLowerCase()}`;
                title.title = title.textContent;
                const type = document.createElement("span");
                type.textContent = `${kind(value.type)}${same(value, destination) ? " · Current default" : ""}`;
                copy.append(title, type);
                const check = document.createElement("span");
                check.className = "notion-result-check";
                check.append(icon("check"));
                row.append(mark, copy, check);
                row.addEventListener("click", () =>
                {
                    draft = value;
                    for (const item of el.notionDestinationResults.children)
                    {
                        const selected = item === row;
                        item.setAttribute("aria-selected", String(selected));
                        item.tabIndex = selected ? 0 : -1;
                    }
                    render();
                });
                el.notionDestinationResults.append(row);
            }
        };
        const loadDestinations = async (
        {
            append = false
        } = {}) =>
        {
            if (!owner || mutation || append && (!nextCursor || loading)) return;
            clearTimeout(searchTimer);
            searchController?.abort();
            searchController = new AbortController();
            const run = ++searchVersion;
            const previousLength = choices.length;
            const identity = owner;
            loading = true;
            el.notionDestinationError.hidden = true;
            el.notionDestinationState.hidden = true;
            el.loadMoreNotionDestinationsBtn.hidden = true;
            if (!append)
            {
                choices = [];
                nextCursor = null;
                el.notionResultsScroll.scrollTop = 0;
                el.notionDestinationResults.replaceChildren();
                for (let i = 0; i < 4; i++)
                {
                    const skeleton = document.createElement("div");
                    skeleton.className = "destination-skeleton";
                    skeleton.setAttribute("aria-hidden", "true");
                    el.notionDestinationResults.append(skeleton);
                }
            }
            el.notionResultsCaption.textContent = append ? "Loading more destinations…" : "Finding shared pages and data sources…";
            render();
            const params = new URLSearchParams();
            const query = el.notionSearchInput.value.trim();
            if (query) params.set("query", query);
            if (append) params.set("cursor", nextCursor);
            try
            {
                const result = await request(`/integrations/notion/destinations${params.size ? `?${params}` : ""}`,
                {
                    method: "GET",
                    signal: searchController.signal,
                    timeoutMs: 15000
                }, identity);
                if (run !== searchVersion) return;
                const data = result.data;
                if (!Array.isArray(data?.destinations) || data.destinations.length > 50 || typeof data.hasMore !== "boolean" ||
                    data.hasMore && !id(data.nextCursor)) throw new Error("Destinations could not be read. Refresh to try again.");
                const entries = data.destinations.map(normalize).filter(Boolean);
                if (entries.length !== data.destinations.length) throw new Error("Destinations could not be read. Refresh to try again.");
                updateKnown(entries);
                choices = [...new Map([...(append ? choices : []), ...entries].map(value => [`${value.type}:${value.id}`, value])).values()];
                nextCursor = data.hasMore ? id(data.nextCursor) : null;
                renderResults();
                if (append && choices.length > previousLength)
                {
                    const firstNew = el.notionDestinationResults.children[previousLength];
                    firstNew?.focus(
                    {
                        preventScroll: true
                    });
                    firstNew?.scrollIntoView(
                    {
                        block: "nearest"
                    });
                }
                el.notionResultsCaption.textContent = `${choices.length} destination${choices.length === 1 ? "" : "s"}${query ? " found" : " shared with Knowvia"}`;
                el.loadMoreNotionDestinationsBtn.hidden = !nextCursor;
                el.notionDestinationState.hidden = choices.length > 0;
                el.notionDestinationStateTitle.textContent = "No destinations found";
                el.notionDestinationStateText.textContent = query ? "Try a different title, or share a page with Knowvia in Notion." :
                    "Share a page or database with Knowvia in Notion, then refresh this list.";
                el.retryNotionDestinationsBtn.hidden = false;
                el.retryNotionDestinationsBtn.textContent = "Refresh destinations";
                await rememberDisplay();
            }
            catch (error)
            {
                if (run !== searchVersion || error.code === "REQUEST_ABORTED" || error.code === "SESSION_CHANGED") return;
                renderResults();
                el.notionResultsCaption.textContent = append ? "Your loaded destinations are still available." : "Destinations unavailable";
                if (!choices.length)
                {
                    el.notionDestinationState.hidden = false;
                    el.notionDestinationStateTitle.textContent = "Couldn't load destinations";
                    el.notionDestinationStateText.textContent = errorText(error);
                    el.retryNotionDestinationsBtn.hidden = false;
                    el.retryNotionDestinationsBtn.textContent = "Try again";
                }
                else
                {
                    el.notionDestinationError.hidden = false;
                    el.notionDestinationError.textContent = errorText(error);
                    el.loadMoreNotionDestinationsBtn.hidden = !nextCursor;
                }
            }
            finally
            {
                if (run === searchVersion)
                {
                    loading = false;
                    render();
                }
            }
        };
        const closeDialog = () =>
        {
            if (mutation) return;
            el.notionDestinationDialog.close();
        };
        const open = async trigger =>
        {
            if (blocked() || mutation) return;
            if (access === "disconnected" || access === "reconnect")
            {
                deps.connect();
                return;
            }
            if (access !== "connected")
            {
                await refresh();
                if (access === "disconnected" || access === "reconnect")
                {
                    deps.connect();
                    return;
                }
                if (!owner || access === "checking") return;
            }
            opener = trigger || document.activeElement;
            draft = destination;
            el.notionSearchInput.value = "";
            el.notionDestinationError.hidden = true;
            if (!el.notionDestinationDialog.open) el.notionDestinationDialog.showModal();
            el.notionSearchInput.focus();
            render();
            void loadDestinations();
        };
        const mutate = async clear =>
        {
            if (mutation || blocked() || !clear && !draft) return;
            if (!clear && same(draft, destination))
            {
                closeDialog();
                return;
            }
            const identity = owner;
            const operation = ++mutationVersion;
            mutation = true;
            deps.onMutation(true);
            el.notionDestinationError.hidden = true;
            busyButton(clear ? el.clearNotionDestinationBtn : el.confirmNotionDestinationBtn, true);
            render();
            try
            {
                const result = await request("/integrations/notion/destination",
                {
                    method: clear ? "DELETE" : "PUT",
                    timeoutMs: 15000,
                    ...(clear ?
                    {} :
                    {
                        body: JSON.stringify(
                        {
                            destinationId: draft.id,
                            destinationType: draft.type
                        })
                    })
                }, identity);
                const value = clear ? null : normalize(result.data?.destination);
                if (clear ? result.data?.destination !== null : !value) throw new Error("The destination change could not be confirmed. Refresh to check it.");
                destination = value;
                selectionReady = true;
                if (value) updateKnown([value]);
                await rememberDisplay();
                mutation = false;
                closeDialog();
                deps.notify(clear ? "Notion default cleared. Choose a destination before sending another capture to Notion." :
                    `Default destination: ${label(destination)}. Enable Notion to send a capture.`, "success", clear ? "Notion default cleared" : "Notion destination updated");
            }
            catch (error)
            {
                if (error.code !== "SESSION_CHANGED")
                {
                    el.notionDestinationError.textContent = errorText(error);
                    el.notionDestinationError.hidden = false;
                }
            }
            finally
            {
                if (operation === mutationVersion)
                {
                    mutation = false;
                    deps.onMutation(false);
                    busyButton(el.clearNotionDestinationBtn, false);
                    busyButton(el.confirmNotionDestinationBtn, false);
                    render();
                }
            }
        };
        const refresh = async () =>
        {
            const run = ++refreshVersion;
            const identity = await deps.getOwner();
            if (run !== refreshVersion) return;
            if (!identity.isSignedIn)
            {
                reset();
                return;
            }
            if (owner && (owner.userId !== identity.userId || owner.session !== identity.session))
            {
                reset();
                return refresh();
            }
            owner = identity;
            if (el.notionDestinationDialog.open && !mutation) closeDialog();
            access = "checking";
            selectionReady = false;
            selectionError = "";
            render();
            el.notionStatus.textContent = "Checking…";
            el.notionStatus.className = "status-pill status-pill--loading";
            try
            {
                const result = await request("/integrations/notion/status",
                {
                    method: "GET",
                    cache: "no-store",
                    timeoutMs: 15000
                }, identity);
                if (run !== refreshVersion) return;
                const status = result.data;
                if (typeof status?.connected !== "boolean" || typeof status.reconnectRequired !== "boolean") throw new Error("Could not verify Notion. Refresh to try again.");
                access = status.reconnectRequired ? "reconnect" : status.connected ? "connected" : "disconnected";
                workspaceName = typeof status.workspaceName === "string" ? status.workspaceName : "";
                el.notionStatus.textContent = status.reconnectRequired ? "Reconnect required" : status.connected ? "Connected" : "Not connected";
                el.notionStatus.className = `status-pill status-pill--${access === "connected" ? "success" : access === "reconnect" ? "warning" : "neutral"}`;
                el.notionConnectionHint.textContent = access === "connected" ? (typeof status.workspaceName === "string" && status.workspaceName || "Workspace connected") :
                    access === "reconnect" ? "Authorize Notion again to restore your connection." : "Connect your Notion workspace to your account.";
                el.connectNotionBtn.textContent = access === "connected" || access === "reconnect" ? "Reconnect" : "Connect";
                el.connectNotionBtn.setAttribute("aria-label", `${el.connectNotionBtn.textContent} Notion`);
                if (access === "connected")
                {
                    try
                    {
                        const selection = await request("/integrations/notion/destination",
                        {
                            method: "GET",
                            cache: "no-store",
                            timeoutMs: 15000
                        }, identity);
                        if (run !== refreshVersion) return;
                        destination = selection.data?.destination === null ? null : normalize(selection.data?.destination);
                        if (selection.data?.destination !== null && !destination) throw new Error("The default destination could not be read.");
                        selectionReady = true;
                        const cached = await deps.readLocal(DISPLAY_KEY);
                        if (run !== refreshVersion) return;
                        if (cached?.userId === identity.userId && same(cached, destination)) updateKnown([normalize(cached)]);
                        // This read supplies display titles only; it never chooses a default.
                        if (destination && !destination.title)
                        {
                            try
                            {
                                const list = await request("/integrations/notion/destinations",
                                {
                                    method: "GET",
                                    timeoutMs: 15000
                                }, identity);
                                if (run !== refreshVersion) return;
                                if (Array.isArray(list.data?.destinations)) updateKnown(list.data.destinations.map(normalize).filter(Boolean));
                            }
                            catch
                            {
                                /* A selected pointer stays honest even if display-title discovery is unavailable. */
                            }
                        }
                    }
                    catch (error)
                    {
                        if (run !== refreshVersion || error.code === "SESSION_CHANGED") return;
                        destination = null;
                        selectionReady = false;
                        selectionError = errorText(error);
                    }
                }
                else
                {
                    destination = null;
                    selectionReady = true;
                }

            }
            catch (error)
            {
                if (run !== refreshVersion || error.code === "SESSION_CHANGED") return;
                access = "error";
                destination = null;
                el.notionStatus.textContent = "Unavailable";
                el.notionStatus.className = "status-pill status-pill--warning";
                el.notionConnectionHint.textContent = errorText(error);
                el.connectNotionBtn.textContent = "Connect";
            }
            finally
            {
                if (run === refreshVersion) render();
            }
        };

        function reset()
        {
            refreshVersion++;
            searchVersion++;
            mutationVersion++;
            searchController?.abort();
            clearTimeout(searchTimer);
            owner = null;
            destination = null;
            selectionReady = false;
            selectionError = "";
            access = "disconnected";
            workspaceName = "";
            mutation = false;
            loading = false;
            deps.onMutation(false);
            known.clear();
            if (el.notionDestinationDialog.open) el.notionDestinationDialog.close();
            render();
        }
        el.notionDestination.addEventListener("click", () =>
        {
            if (blocked()) return;
            deps.toggleSelected();
            render();
            if (deps.isSelected() && !(access === "connected" && selectionReady && destination)) void open(el.notionDestination);
        });
        document.getElementById("chooseNotionSaveDestinationBtn").addEventListener("click", event => void open(event.currentTarget));
        el.manageNotionDestinationBtn.addEventListener("click", () => void open(el.manageNotionDestinationBtn));
        el.closeNotionDialogBtn.addEventListener("click", closeDialog);
        el.cancelNotionDestinationBtn.addEventListener("click", closeDialog);
        el.notionDestinationDialog.addEventListener("cancel", event =>
        {
            if (mutation) event.preventDefault();
        });
        el.notionDestinationDialog.addEventListener("keydown", event =>
        {
            if (event.key !== "Tab") return;
            const controls = [...el.notionDestinationDialog.querySelectorAll("button:not(:disabled), input:not(:disabled), [tabindex='0']")]
                .filter(node => node.getClientRects().length && !node.closest("[hidden]"));
            const first = controls[0],
                last = controls.at(-1);
            if (event.shiftKey && document.activeElement === first)
            {
                event.preventDefault();
                last?.focus();
            }
            else if (!event.shiftKey && document.activeElement === last)
            {
                event.preventDefault();
                first?.focus();
            }
        });
        el.notionDestinationDialog.addEventListener("close", () =>
        {
            searchVersion++;
            searchController?.abort();
            clearTimeout(searchTimer);
            if (opener?.isConnected && opener.getClientRects().length) opener.focus();
        });
        el.notionDestinationDialog.addEventListener("click", event =>
        {
            if (event.target !== el.notionDestinationDialog) return;
            const box = el.notionDestinationDialog.getBoundingClientRect();
            if (event.clientX < box.left || event.clientX > box.right || event.clientY < box.top || event.clientY > box.bottom) closeDialog();
        });
        el.notionSearchInput.addEventListener("input", () =>
        {
            searchController?.abort();
            searchVersion++;
            clearTimeout(searchTimer);
            searchTimer = setTimeout(() => void loadDestinations(), 250);
        });
        el.notionSearchInput.addEventListener("keydown", event =>
        {
            if (event.key === "ArrowDown")
            {
                event.preventDefault();
                el.notionDestinationResults.querySelector("button")?.focus();
            }
            if (event.key === "Enter")
            {
                event.preventDefault();
                void loadDestinations();
            }
        });
        el.notionDestinationResults.addEventListener("keydown", event =>
        {
            if (!["ArrowDown", "ArrowUp", "Home", "End"].includes(event.key)) return;
            event.preventDefault();
            const rows = [...el.notionDestinationResults.querySelectorAll("button")];
            if (!rows.length) return;
            const index = rows.indexOf(document.activeElement);
            const next = event.key === "Home" ? 0 : event.key === "End" ? rows.length - 1 :
                (index + (event.key === "ArrowDown" ? 1 : rows.length - 1)) % rows.length;
            rows[next].click();
            rows[next].focus();
            rows[next].scrollIntoView(
            {
                block: "nearest"
            });
        });
        el.refreshNotionDestinationsBtn.addEventListener("click", () => void loadDestinations());
        el.retryNotionDestinationsBtn.addEventListener("click", () => void loadDestinations());
        el.loadMoreNotionDestinationsBtn.addEventListener("click", () => void loadDestinations(
        {
            append: true
        }));
        el.confirmNotionDestinationBtn.addEventListener("click", () => void mutate(false));
        el.clearNotionDestinationBtn.addEventListener("click", () => void mutate(true));
        // Provider receipts now use the shared read-only synchronization panel.

        render();
        return {
            refresh,
            reset,
            destination: () => destination ?
            {
                destinationId: destination.id,
                destinationType: destination.type
            } :
            {},
            hasDestination: () => access === "connected" && selectionReady && Boolean(destination),
            isDialogOpen: () => el.notionDestinationDialog.open,
            setBlocked: value =>
            {
                authBlocked = value;
                render();
            }
        };
    };
    globalThis.KnowviaNotion = Object.freeze(
    {
        create
    });
})();
</file>

<file path="extension/sync-status.js">
/* Read-only polling never starts a provider write. Explicit retries use the
   backend's persisted intent and claims, not current popup destination toggles. */
(() =>
{
    const KEY = "knowvia_last_sync";
    const labels = {
        not_requested: "Not requested",
        queued: "Queued",
        pending: "In progress",
        synced: "Synchronized",
        failed: "Failed",
        partial: "Partly synchronized",
        uncertain: "Needs review"
    };
    const safeNotion = value =>
    {
        try
        {
            const url = new URL(value);
            return url.protocol === "https:" && !url.username && !url.password && !url.port &&
                /(^|\.)(notion\.so|notion\.site|notion\.com)$/.test(url.hostname) ? url.href : null;
        }
        catch
        {
            return null;
        }
    };
    globalThis.KnowviaSync = {
        create(deps)
        {
            const section = document.getElementById("syncReceipt");
            const detail = document.getElementById("syncReceiptDetail");
            const refresh = document.getElementById("refreshSyncStatusBtn");
            let receipt = null,
                timer = null,
                busy = false,
                epoch = 0,
                polls = 0;
            const cooldown = {
                ticktick: 0,
                notion: 0
            };
            const current = async identity =>
            {
                const owner = await deps.getOwner();
                return owner.isSignedIn && identity?.userId === owner.userId && identity.session === owner.session;
            };
            const render = () =>
            {
                section.hidden = !receipt;
                refresh.disabled = busy;
                refresh.textContent = busy ? "Checking…" : "Refresh status";
                for (const provider of ["ticktick", "notion"])
                {
                    const state = receipt?.data?.[provider];
                    const row = document.getElementById(`${provider}SyncRow`);
                    const text = document.getElementById(`${provider}SyncState`);
                    const retry = document.getElementById(`${provider}SyncRetry`);
                    row.hidden = !state;
                    row.dataset.state = state?.status || "unknown";
                    text.textContent = state ? labels[state.status] || "Not confirmed" : "";
                    if (provider === "ticktick" && state?.aiStatus === "failed") text.textContent += " · AI unavailable";
                    retry.hidden = !state?.retryable;
                    retry.disabled = busy || deps.isBlocked() || cooldown[provider] > Date.now();
                }
                const open = document.getElementById("openConfirmedNotionBtn");
                open.hidden = receipt?.data?.notion?.status !== "synced" || !safeNotion(receipt?.data?.notion?.pageUrl);
                window.KnowviaV2?.sync(receipt?.data || null);
            };
            const read = async (automatic = false) =>
            {
                if (!receipt || busy || !await current(receipt.owner)) return;
                clearTimeout(timer);
                const operation = epoch,
                    target = receipt;
                busy = true;
                render();
                try
                {
                    const result = await deps.apiFetch(`/content/${target.contentId}/sync-status`,
                    {
                        timeoutMs: 10000
                    });
                    if (operation !== epoch || !await current(target.owner)) return;
                    if (result.data?.contentId !== target.contentId || !result.data?.ticktick || !result.data?.notion) throw new Error("Synchronization status could not be confirmed.");
                    receipt.data = result.data;
                    const needsReview = [result.data.ticktick, result.data.notion].some(state => state.status === "uncertain");
                    detail.textContent = needsReview ? "Saved in Knowvia. An external write may have completed. Review that provider before creating another copy." :
                        "Saved in Knowvia. External copies are tracked independently.";
                    await deps.writeLocal(KEY,
                    {
                        userId: target.owner.userId,
                        contentId: target.contentId
                    });
                    const active = [result.data.ticktick, result.data.notion].some(state => ["queued", "pending"].includes(state.status));
                    if (active && polls++ < 12) timer = setTimeout(() => void read(true), 1500);
                    else if (active) detail.textContent = "Saved in Knowvia. Synchronization is still pending; refresh later. Closing this popup does not cancel it.";
                }
                catch (error)
                {
                    if (operation === epoch) detail.textContent = `Saved in Knowvia. ${error.message} Use Refresh status to check again.`;
                }
                finally
                {
                    if (operation === epoch)
                    {
                        busy = false;
                        render();
                    }
                }
            };
            const retry = async provider =>
            {
                if (busy || deps.isBlocked() || !receipt?.data?.[provider]?.retryable || !await current(receipt.owner)) return;
                if (cooldown[provider] > Date.now()) return;
                clearTimeout(timer);
                receipt.data[provider] = {
                    ...receipt.data[provider],
                    status: "pending",
                    retryable: false
                };
                busy = true;
                render();
                const target = receipt,
                    operation = epoch;
                try
                {
                    const path = provider === "notion" ? `/integrations/notion/sync/${target.contentId}` : `/content/${target.contentId}/sync/ticktick`;
                    await deps.apiFetch(path,
                    {
                        method: "POST",
                        timeoutMs: 75000
                    });
                }
                catch (error)
                {
                    if (operation === epoch)
                    {
                        detail.textContent = error.message;
                        if (error.status === 429)
                        {
                            cooldown[provider] = Date.now() + Math.min(3600, Math.max(1, error.retryAfter || 5)) * 1000;
                            setTimeout(render, cooldown[provider] - Date.now() + 30);
                        }
                    }
                }
                finally
                {
                    if (operation === epoch)
                    {
                        busy = false;
                        polls = 0;
                        render();
                        await read();
                    }
                }
            };
            refresh.addEventListener("click", () =>
            {
                polls = 0;
                void read();
            });
            for (const provider of ["ticktick", "notion"]) document.getElementById(`${provider}SyncRetry`).addEventListener("click", () => void retry(provider));
            document.getElementById("openConfirmedNotionBtn").addEventListener("click", () =>
            {
                const url = receipt?.data?.notion?.status === "synced" && safeNotion(receipt.data.notion.pageUrl);
                if (url) chrome.tabs.create(
                {
                    url
                }).catch(() =>
                {
                    detail.textContent = "Could not open Notion. Try again.";
                });
            });
            return {
                async saved(contentId)
                {
                    if (!/^[a-f0-9]{24}$/i.test(contentId)) return;
                    epoch++;
                    clearTimeout(timer);
                    busy = false;
                    polls = 0;
                    receipt = {
                        contentId,
                        owner: await deps.getOwner(),
                        data: null
                    };
                    detail.textContent = "Saved in Knowvia. Checking external copies…";
                    render();
                    await deps.writeLocal(KEY,
                    {
                        userId: receipt.owner.userId,
                        contentId
                    });
                    void read();
                },
                async restore()
                {
                    const stored = await deps.readLocal(KEY),
                        owner = await deps.getOwner();
                    if (owner.isSignedIn && stored?.userId === owner.userId && /^[a-f0-9]{24}$/i.test(stored.contentId))
                        await this.saved(stored.contentId);
                },
                reset()
                {
                    epoch++;
                    clearTimeout(timer);
                    receipt = null;
                    busy = false;
                    render();
                }
            };
        }
    };
})();
</file>

<file path="extension/v2-layout.js">
/* Approved V2 composition, using existing controls and API handlers. No demo data. */
(() =>
{
    const byId = id => document.getElementById(id);
    const make = (tag, className, html = "") =>
    {
        const node = document.createElement(tag);
        node.className = className;
        node.innerHTML = html;
        return node;
    };
    const panel = byId("panelSave");
    panel.classList.add("v2-capture");
    const intro = make("div", "v2-intro", '<h1>Save to platforms</h1><p>Review your content and choose where to save it.</p>');
    const composition = make("div", "v2-composition");
    panel.prepend(composition);
    const editor = make("div", "v2-editor");
    composition.append(editor);
    editor.append(intro, byId("captureEditor"));
    const metadata = make("div", "v2-metadata");
    const attachments = make("section", "v2-attachments", '<h2>Attached images</h2><button class="v2-upload" type="button" disabled aria-describedby="attachmentSupport"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8" cy="8" r="1.5"/><path d="m3 17 6-6 4 4 3-3 5 5"/></svg><span><strong>Add images</strong><small>For your note or task</small></span><span class="v2-upload-plus" aria-hidden="true">+</span></button><p id="attachmentSupport">Uploads unavailable: this server does not accept attachments.</p>');
    metadata.append(attachments, byId("tagsField"));
    editor.append(metadata);
    const preview = byId("articlePreview");
    preview.prepend(make("div", "v2-preview-head", '<strong>Article preview</strong><span id="previewContentType">Web article</span>'));
    const previewTags = make("div", "v2-preview-tags");
    previewTags.id = "previewTags";
    preview.append(previewTags);
    composition.append(editor, preview);
    const destinations = make("section", "v2-destinations", '<div class="v2-dest-heading"><div><h2>Save to destinations</h2><p>Choose where to send a copy. Drag to reorder, or use the arrows.</p></div><button id="managePlatformsBtn" class="btn btn-secondary btn-sm" type="button" aria-haspopup="dialog" aria-controls="platformVisibilityDialog"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-settings"/></svg>Manage platforms</button></div>');
    const list = make("div", "v2-destination-list");
    list.id = "destinationRows";
    destinations.append(list);
    panel.append(destinations);
    for (const [provider, tile] of [
            ["notion", "notionDestination"],
            ["ticktick", "connectTickTickFromSaveBtn"]
        ])
    {
        const row = make("article", "v2-destination-row");
        row.dataset.provider = provider;
        const reorder = make("div", "v2-reorder", `<span draggable="true" class="drag-handle" aria-hidden="true" title="Drag to reorder"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5h.01M15 5h.01M9 12h.01M15 12h.01M9 19h.01M15 19h.01" stroke-width="3"/></svg></span><button type="button" data-move="-1" aria-label="Move ${provider} up"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5m-6 6 6-6 6 6"/></svg></button><button type="button" data-move="1" aria-label="Move ${provider} down"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14m-6-6 6 6 6-6"/></svg></button>`);
        row.append(reorder, byId(tile));
        const configuration = make("div", "v2-provider-config");
        configuration.id = `${provider}Configuration`;
        if (provider === "notion")
        {
            const fields = byId("notionSaveConfig");
            const choose = byId("chooseNotionSaveDestinationBtn");
            const name = byId("notionSaveDestinationName");
            fields.className = "v2-inline-fields";
            fields.replaceChildren();
            const workspace = make("div", "v2-field", '<label for="notionWorkspace">Workspace</label><input id="notionWorkspace" class="v2-static-field" value="Not connected" readonly aria-describedby="notionFieldsHelp"/>');
            const destination = make("div", "v2-field", '<label id="notionInlineDestinationLabel">Page / database</label>');
            choose.className = "v2-select-button";
            choose.setAttribute("aria-labelledby", "notionInlineDestinationLabel notionSaveDestinationName");
            choose.setAttribute("aria-haspopup", "dialog");
            choose.setAttribute("aria-controls", "notionDestinationDialog");
            choose.replaceChildren(name);
            choose.insertAdjacentHTML("beforeend", '<svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-chevron-down"/></svg>');
            destination.append(choose);
            fields.append(workspace, destination, make("div", "v2-field", '<label for="notionPageType">Page type</label><input id="notionPageType" class="v2-static-field" value="Standard page" readonly aria-describedby="notionFieldsHelp"/>'));
            configuration.append(fields, make("p", "sr-only", 'Workspace is set by your Notion connection. The server creates standard pages; custom page types are not supported.'));
            configuration.lastChild.id = "notionFieldsHelp";
        }
        else
        {
            const fields = make("div", "v2-inline-fields");
            byId("projectFieldLabel").firstElementChild.textContent = "List";
            fields.append(byId("projectField"));
            for (const [key, label] of [
                    ["dueDate", "Due date"],
                    ["priority", "Priority"]
                ])
                fields.append(make("div", "v2-field", `<label for="ticktick${key}">${label}</label><select id="ticktick${key}" disabled aria-describedby="ticktickFieldsHelp"><option>Unavailable</option></select>`));
            configuration.append(fields, make("p", "v2-capability-note", 'Due dates and priorities are not supported by this server.'));
            configuration.lastChild.id = "ticktickFieldsHelp";
            configuration.lastChild.className = "sr-only";
            for (const field of fields.querySelectorAll("select:disabled")) field.title = "This server does not support saving due dates or priorities.";
            const ai = make("details", "v2-ticktick-ai", '<summary>TickTick task content / AI</summary><p>These options affect only the TickTick copy.</p>');
            for (const id of ["useSummaryAi", "useTagsAi", "mergeSummaryWithContent"]) ai.append(byId(id).closest("label"));
            const identity = make("div", "v2-provider-identity");
            const toggle = row.querySelector(".destination-card");
            toggle.before(identity);
            identity.append(toggle, ai);
        }
        row.append(configuration);
        list.append(row);
    }
    destinations.append(list);
    panel.prepend(composition, destinations);
    byId("destinationHeading").closest("section").hidden = true;
    byId("destinationHeading").closest("section").setAttribute("aria-hidden", "true");
    byId("saveOptionsHeading").closest("section").hidden = true;
    const quiz = byId("useQuiz").closest("label");
    const inclusion = make("div", "v2-inclusion");
    inclusion.append(quiz);
    inclusion.hidden = true;
    editor.append(inclusion);
    byId("captureOptionsBtn").hidden = true;
    byId("captureOptions").hidden = true;
    byId("doneEditingBtn").hidden = true;
    byId("editCaptureBtn").hidden = true;
    byId("captureEditor").hidden = false;
    byId("rawText").previousElementSibling.querySelector("label").textContent = "Summary / description";
    byId("rawText").setAttribute("aria-describedby", "rawTextError");
    byId("title").setAttribute("aria-describedby", "titleError");
    for (const field of ["title", "rawText"])
    {
        const error = make("p", "v2-field-error");
        error.id = `${field}Error`;
        error.hidden = true;
        error.setAttribute("role", "alert");
        byId(field).after(error);
    }
    const source = make("details", "v2-source", '<summary>Source · <bdi id="sourceHost">Add URL</bdi><span> Edit</span></summary>');
    const url = byId("url");
    source.append(url.previousElementSibling, url);
    preview.append(source);
    const refreshSource = () =>
    {
        try
        {
            byId("sourceHost").textContent = new URL(url.value).hostname;
        }
        catch
        {
            byId("sourceHost").textContent = url.value ? "Review URL" : "Add URL";
        }
    };
    url.addEventListener("input", refreshSource);

    refreshSource();
    for (const brand of document.querySelectorAll(".brand-lockup"))
    {
        brand.replaceChildren();
        const logo = document.createElement("img");
        logo.src = "assets/knowvia-approved-wordmark.png";
        logo.alt = "Knowvia";
        logo.className = "v2-wordmark";
        brand.append(logo);
    }
    // Native dialog gives the approved overlay a focus trap, Escape and inert backdrop.
    const dialog = make("dialog", "v2-platform-dialog", '<header><div><span class="v2-eyebrow">KNOWVIA SETTINGS</span><h2 id="platformDialogTitle">Your platforms</h2></div><button id="closePlatformsBtn" class="icon-button" aria-label="Close platform settings" type="button"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-close"/></svg></button></header><p id="platformDialogDescription">Decide what appears on your save page. You can bring a platform back any time.</p><section class="v2-platform-options"><div class="v2-options-heading"><strong>Show on save page</strong><span id="visiblePlatformCount">2 of 2 visible</span></div><div id="platformOptions"></div><p class="v2-platform-hint">Hiding a platform removes it from the main form, not your account. To temporarily skip saving to a visible platform, use its switch on the save page.</p></section><footer><button id="resetPlatformsBtn" class="btn btn-secondary btn-sm" type="button">Reset defaults</button><button id="donePlatformsBtn" class="btn btn-primary" type="button">Done</button></footer>');
    dialog.id = "platformVisibilityDialog";
    dialog.setAttribute("aria-labelledby", "platformDialogTitle");
    dialog.setAttribute("aria-describedby", "platformDialogDescription");
    document.body.append(dialog);
    for (const [provider, label, inputId, description] of [
            ["notion", "Notion", "showNotionPlatform", "Knowledge pages and notes"],
            ["ticktick", "TickTick", "showTicktickPlatform", "Tasks and reminders"]
        ])
        byId("platformOptions").append(make("label", "v2-platform-option", `<span class="platform-logo ${provider}-logo"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-${provider}"/></svg></span><span class="v2-platform-copy"><strong>${label}</strong><small>${description}</small></span><input id="${inputId}" aria-label="Show ${label} on save page" type="checkbox" checked/><span class="v2-visibility-switch" aria-hidden="true"></span>`));
    const settings = make("article", "settings-card v2-platform-settings", '<h3>Your platforms</h3><p>Choose what appears on your save page. Your connections stay available.</p><button id="settingsManagePlatformsBtn" class="btn btn-secondary btn-sm" type="button" aria-haspopup="dialog" aria-controls="platformVisibilityDialog">Manage platforms</button>');
    settings.id = "platformVisibilitySettings";
    byId("panelSettings").append(settings);
    const progress = make("div", "v2-save-progress", '<progress id="destinationProgress" value="0" max="1" aria-label="Confirmed destinations"></progress><span id="destinationProgressCount">—</span>');
    byId("appFooter").append(progress);
    const tagsValue = document.querySelector(".tags-picker-value");
    const addTag = make("button", "v2-add-tag", "+ Add tag");
    addTag.type = "button";
    addTag.id = "addTagBtn";
    addTag.setAttribute("aria-controls", "tagInput");
    addTag.setAttribute("aria-expanded", "false");
    tagsValue.append(addTag);
    const titleCount = make("span", "v2-title-count");
    titleCount.id = "titleCount";
    const titleWrap = make("div", "v2-title-wrap");
    byId("title").before(titleWrap);
    titleWrap.append(byId("title"), titleCount);
    let syncData = null;
    const refresh = () =>
    {
        refreshSource();
        const count = Number(ticktickSelected) + Number(notionSelected);
        titleCount.textContent = `${byId("title").value.length}/500`;
        byId("previewContentType").textContent = /^https?:\/\//.test(byId("url").value) ? "Web article" : "Note";
        if (byId("statusBar").classList.contains("status-bar--info"))
        {
            byId("statusTitle").textContent = "Ready to save";
            byId("statusText").textContent = count ? `${count} destination${count === 1 ? "" : "s"} selected` : "Knowvia collection only";
        }
        const states = syncData ? [syncData.ticktick, syncData.notion].filter(value => value && value.status !== "not_requested") : [];
        const confirmed = states.filter(value => value.status === "synced").length;
        const total = syncData ? states.length : count;
        byId("destinationProgress").max = Math.max(1, total);
        byId("destinationProgress").value = confirmed;
        byId("destinationProgressCount").textContent = total ? `${confirmed}/${total}` : "—";
        progress.title = syncData ? "Confirmed external destinations for the last saved capture" : "Destinations selected for this capture";
        byId("destinationProgress").setAttribute("aria-label", progress.title);
    };
    window.KnowviaV2 = {
        refresh,
        sync: data =>
        {
            syncData = data;
            refresh();
        },
        reset: () =>
        {
            syncData = null;
            refresh();
        }
    };
    document.addEventListener("DOMContentLoaded", async () =>
    {
        const defaults = () => (
        {
            order: ["notion", "ticktick"],
            visible:
            {
                notion: true,
                ticktick: true
            }
        });
        let preferences = defaults();
        const owner = await chrome.storage.local.get(["sk_userId", "ticktick_userId"]);
        let key = `knowvia_platform_layout_${owner.sk_userId || owner.ticktick_userId || "guest"}`;
        const stored = (await chrome.storage.local.get([key]))[key];
        if (stored?.order?.length === 2 && new Set(stored.order).size === 2 && stored.order.every(value => ["notion", "ticktick"].includes(value)))
            preferences = {
                order: stored.order,
                visible:
                {
                    notion: stored.visible?.notion !== false,
                    ticktick: stored.visible?.ticktick !== false
                }
            };
        const rows = Object.fromEntries([...list.children].map(row => [row.dataset.provider, row]));
        const update = () =>
        {
            for (const [index, provider] of preferences.order.entries())
            {
                const row = rows[provider];
                row.hidden = !preferences.visible[provider];
                row.querySelector('[data-move="-1"]').disabled = index === 0;
                row.querySelector('[data-move="1"]').disabled = index === preferences.order.length - 1;
                list.append(row);
            }
            byId("showNotionPlatform").checked = preferences.visible.notion;
            byId("showTicktickPlatform").checked = preferences.visible.ticktick;
            byId("visiblePlatformCount").textContent = `${Number(preferences.visible.notion) + Number(preferences.visible.ticktick)} of 2 visible`;
            if (!preferences.visible.ticktick) ticktickSelected = false;
            if (!preferences.visible.notion) notionSelected = false;
            renderDestinationSelection();
            document.querySelector(".v2-ticktick-ai").hidden = !ticktickSelected;
            notionUI.setBlocked(authPending);
        };
        const persist = () => chrome.storage.local.set(
        {
            [key]: preferences
        }).catch(() => setStatus("Could not store platform preferences. Try again.", "warning"));
        const move = (provider, offset) =>
        {
            const current = preferences.order.indexOf(provider),
                next = current + offset;
            if (next < 0 || next >= 2 || savePending) return;
            [preferences.order[current], preferences.order[next]] = [preferences.order[next], preferences.order[current]];
            update();
            void persist();
            rows[provider].querySelector(`[data-move="${-offset}"]`).focus();
        };
        let dragging = null;
        for (const [provider, row] of Object.entries(rows))
        {
            row.querySelectorAll("[data-move]").forEach(button => button.addEventListener("click", () => move(provider, Number(button.dataset.move))));
            row.addEventListener("dragstart", event =>
            {
                if (savePending)
                {
                    event.preventDefault();
                    return;
                }
                dragging = provider;
                row.classList.add("is-dragging");
                event.dataTransfer.setData("text/plain", provider);
            });
            row.addEventListener("dragover", event =>
            {
                if (dragging)
                {
                    event.preventDefault();
                    row.classList.add("drag-over");
                }
            });
            row.addEventListener("drop", event =>
            {
                event.preventDefault();
                if (dragging && dragging !== provider) move(dragging, preferences.order.indexOf(provider) - preferences.order.indexOf(dragging));
                dragging = null;
            });
            row.addEventListener("dragleave", () => row.classList.remove("drag-over"));
            row.addEventListener("dragend", () =>
            {
                dragging = null;
                Object.values(rows).forEach(item => item.classList.remove("drag-over", "is-dragging"));
            });
        }
        for (const [provider, id] of [
                ["notion", "showNotionPlatform"],
                ["ticktick", "showTicktickPlatform"]
            ])
            byId(id).addEventListener("change", () =>
            {
                if (savePending)
                {
                    update();
                    return;
                }
                preferences.visible[provider] = byId(id).checked;
                update();
                void persist();
            });
        byId("resetPlatformsBtn").addEventListener("click", () =>
        {
            if (savePending) return;
            preferences = defaults();
            update();
            void persist();
        });
        let platformOpener;
        for (const id of ["managePlatformsBtn", "settingsManagePlatformsBtn"])
            byId(id).addEventListener("click", event =>
            {
                if (savePending) return;
                platformOpener = event.currentTarget;
                hideProjectMenu();
                hideTagSuggestions();
                dialog.showModal();
            });
        for (const id of ["closePlatformsBtn", "donePlatformsBtn"]) byId(id).addEventListener("click", () => dialog.close());
        dialog.addEventListener("close", () => platformOpener?.focus());
        dialog.addEventListener("click", event =>
        {
            if (event.target === dialog)
            {
                const bounds = dialog.getBoundingClientRect();
                if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) dialog.close();
            }
        });
        addTag.addEventListener("click", () =>
        {
            tagsValue.classList.add("is-editing");
            addTag.setAttribute("aria-expanded", "true");
            byId("tagInput").focus();
        });
        byId("tagInput").addEventListener("blur", () =>
        {
            if (!byId("tagInput").value.trim())
            {
                tagsValue.classList.remove("is-editing");
                addTag.setAttribute("aria-expanded", "false");
            }
        });
        for (const id of ["title", "rawText", "url"]) byId(id).addEventListener("input", () =>
        {
            byId(`${id}Error`)?.setAttribute("hidden", "");
            byId(id).removeAttribute("aria-invalid");
            window.KnowviaV2.reset();
        });
        const renderPreview = () =>
        {
            previewTags.replaceChildren();
            for (const chip of byId("selectedTagsContainer").children)
            {
                const tag = document.createElement("span");
                tag.className = "v2-preview-tag";
                tag.textContent = chip.querySelector(".tag-chip-label")?.textContent || chip.firstChild?.textContent || "";
                previewTags.append(tag);
            }
            document.querySelector(".v2-ticktick-ai").hidden = !ticktickSelected;
        };
        new MutationObserver(renderPreview).observe(byId("selectedTagsContainer"),
        {
            childList: true,
            subtree: true
        });
        byId("connectTickTickFromSaveBtn").addEventListener("click", renderPreview);
        chrome.storage.onChanged.addListener(async (changes, area) =>
        {
            if (area !== "local" || !changes.sk_userId) return;
            const nextKey = `knowvia_platform_layout_${changes.sk_userId.newValue || "guest"}`;
            if (nextKey === key) return;
            key = nextKey;
            const next = (await chrome.storage.local.get([key]))[key];
            preferences = defaults();
            if (next?.order?.length === 2 && new Set(next.order).size === 2 && next.order.every(value => ["notion", "ticktick"].includes(value)))
                preferences = {
                    order: next.order,
                    visible:
                    {
                        notion: next.visible?.notion !== false,
                        ticktick: next.visible?.ticktick !== false
                    }
                };
            update();
        });
        update();
        renderPreview();
    });
})();
