.destination-dialog-actions { display: flex; align-items: center; gap: var(--space-2); }
.dialog-actions-spacer { flex: 1; }
.destructive-text { color: var(--red); }
.destructive-text:hover { background: var(--red-soft); }
.full-screen-center { height: 100%; overflow-y: auto; padding: var(--space-6); align-items: safe center; justify-content: center; background: var(--surface); border-radius: var(--r-lg); scrollbar-width: thin; }
.onboard-container { width: 100%; margin: auto; }
.welcome-brand { display: flex; align-items: center; gap: var(--space-2); }
.welcome-version { margin-left: auto; max-width: 90px; font-size: 9px; line-height: 1.5; letter-spacing: .08em; color: var(--ink-3); text-align: right; }
.welcome-heading { margin-top: 28px; }
.onboard-eyebrow { font-size: 10px; letter-spacing: .08em; color: var(--blue); font-weight: 600; }
.onboard-container h1 { margin-top: var(--space-3); font-size: 29px; line-height: 1.2; letter-spacing: -.9px; color: var(--ink-0); font-weight: 650; }
.onboard-container h1 span { color: var(--blue); }
.onboard-lead { margin-top: var(--space-3); font-size: 13px; line-height: 1.7; color: var(--ink-2); }
.welcome-preview { margin: var(--space-6) 0; padding: var(--space-4); border-radius: var(--r-md); color: #fff; background: var(--navy); }
.preview-top { display: flex; align-items: center; gap: var(--space-2); font-size: 9px; line-height: 1.5; letter-spacing: .03em; color: #c7d2ed; }
.preview-bookmark { display: grid; place-items: center; flex: none; width: 28px; height: 28px; border-radius: var(--r-sm); background: #344999; color: #fff; }
.preview-bookmark svg { width: var(--icon-sm); height: var(--icon-sm); }
.preview-title { margin-top: var(--space-3); font-size: 16px; font-weight: 600; letter-spacing: -.15px; }
.preview-description { margin: 8px 0 16px; color: #cad6ed; font-size: var(--text-body); line-height: 1.65; }
.preview-bottom { display: flex; justify-content: space-between; flex-wrap: wrap; gap: var(--space-2); font-size: 10px; color: #cbd6ec; }
.welcome-action-copy { display: grid; gap: var(--space-1); margin-bottom: var(--space-3); font-size: 13px; }
.welcome-action-copy strong { font-weight: 600; }
.welcome-action-copy span { font-size: var(--text-body); color: var(--ink-3); }
.google-auth-btn { display: flex; justify-content: center; align-items: center; gap: var(--space-3); width: 100%; min-height: 44px; padding: 10px 12px; border: 1px solid var(--border); border-radius: var(--r-sm); color: var(--ink-0); background: var(--surface); font-weight: 600; font-size: 13px; }
.google-auth-btn:hover:not(:disabled) { background: var(--bg-3); border-color: var(--blue-ring); }
.google-auth-icon { display: grid; place-items: center; }
.google-auth-icon svg { width: var(--icon-md); height: var(--icon-md); stroke: none; }
.google-auth-label { flex: 1; text-align: center; }
.google-auth-arrow svg { width: var(--icon-sm); height: var(--icon-sm); color: var(--ink-3); }
.onboard-footer-note { display: flex; justify-content: center; align-items: center; gap: 6px; margin-top: var(--space-3); font-size: var(--text-caption); color: var(--ink-3); }
.onboard-footer-note svg { width: 14px; height: 14px; }
.auth-status { margin-top: var(--space-3); padding: 10px 12px; background: var(--bg-3); border: 1px solid var(--border); border-radius: var(--r-sm); font-size: var(--text-body); line-height: 1.6; color: var(--ink-2); }
.auth-status[data-state="error"] { color: var(--red); border-color: var(--red-ring); background: var(--red-soft); }
@keyframes spin { to { transform: rotate(360deg); } }
@keyframes progress { from { transform: translateX(-110%); } to { transform: translateX(390%); } }
@keyframes reveal { from { opacity: 0; transform: translateY(2px); } to { opacity: 1; transform: translateY(0); } }
@media (min-width: 300px) and (max-width: 479px) {
  html { width: 100vw; }
}
@media (max-width: 380px) {
  .shell { padding: 4px; }
  .popup-header { padding-inline: 12px; }
  .main-scroll, .save-actions { padding-inline: 12px; }
  .article-preview { gap: var(--space-2); padding: 10px; }
  .preview-cover { width: 56px; height: 76px; }
  .article-preview-copy h2 { font-size: 14px; }
  .destination-grid { grid-template-columns: 1fr; }
  .destination-card { min-height: 56px; }
  .destination-copy strong { font-size: 13px; }
  .save-option { flex-direction: column; align-items: flex-start; gap: 6px; min-height: 84px; }
  .save-option small { font-size: 10px; }
  .ai-options-grid { grid-template-columns: 1fr; }
  .full-screen-center { padding: var(--space-5); }
  .welcome-heading { margin-top: var(--space-6); }
  .onboard-container h1 { font-size: 27px; }
  #saveArticleBtn { padding-inline: 20px; }
  #saveArticleBtn kbd { display: none; }
  .destination-dialog { width: calc(100vw - 16px); max-height: calc(100dvh - 16px); }
  .destination-dialog-header { padding: 12px; gap: 8px; }
  .destination-dialog-header h2 { font-size: 16px; }
  .destination-search-row { padding-inline: 12px; }
  .destination-dialog-header .dialog-provider-icon { display: none; }
  .destination-dialog-actions { flex-wrap: wrap; }
  .destination-dialog-footer { padding: 12px; }
  .destination-dialog-actions .dialog-actions-spacer { display: none; }
  .destination-dialog-actions > .destructive-text { flex: 1 1 100%; justify-content: flex-start; }
  .destination-dialog-actions > .btn { flex: 1; }
  .status-bar:has(.status-action:not([hidden])) { flex-wrap: wrap; }
  .status-bar:has(.status-action:not([hidden])) .status-copy { flex-basis: calc(100% - 40px); }
  .status-action { margin-left: 36px; }
}
@media (pointer: coarse) {
  :root { --hit-sm: 44px; --hit-md: 44px; --control-height: 46px; }
  .tag-chip-remove { width: 44px; height: 44px; }
  .toggle-wrap { width: 44px; height: 44px; }
  .toggle-row { min-height: 44px; }
  .section-heading .text-button { min-height: 36px; margin-block: 0; }
}
@media (max-height: 480px) {
  .destination-dialog-header { padding: 12px; }
  .destination-dialog-header p { display: none; }
  .destination-dialog-footer { padding: 10px 12px; }
  .destination-dialog-footer > p { display: none; }
  .destination-results-caption { margin-bottom: 6px; }
  .destination-empty { min-height: 140px; padding: 16px; }
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { transition: none !important; animation: none !important; scroll-behavior: auto !important; }
  .status-progress > span { width: 100%; opacity: .5; }
}
</file>

<file path="extension/manifest.json">
{
  "manifest_version": 3,
  "name": "Knowvia \u2014 Capture knowledge",
  "version": "2.2.0",
  "description": "Capture knowledge. Turn it into action. Save articles, selections, and notes to Knowvia and your connected TickTick lists.",
  "permissions": [
    "activeTab",
    "storage",
    "identity",
    "tabs",
    "contextMenus",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://lionfish-app-jxpvk.ondigitalocean.app/*",
    "https://accounts.google.com/*",
    "https://ticktick.com/*",
    "https://api.ticktick.com/*",
    "https://t.me/*",
    "https://telegram.me/*",
    "<all_urls>",
    "http://localhost:3000/*"
  ],
  "action": {
    "default_title": "Capture with Knowvia",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "oauth2": {
    "client_id": "YOUR_GOOGLE_CLIENT_ID_IF_NEEDED",
    "scopes": []
  }
}
</file>

