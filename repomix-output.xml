@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Mono:wght@400;500&family=Instrument+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap');

/* =========================================
   1. DESIGN TOKENS — LIGHT MODE
========================================= */
:root {
  color-scheme: light;

  /* Brand */
  --blue:        #3b5bfb;
  --blue-hover:  #2a46e5;
  --blue-soft:   rgba(59, 91, 251, 0.15);
  --blue-ring:   rgba(59, 91, 251, 0.25);

  /* Backgrounds */
  --bg:          #f8f9fa;
  --surface:     #ffffff;
  --border:      #e2e8f0;
  --border-soft: #f1f5f9;

  /* Typography */
  --ink-0: #0f172a;
  --ink-1: #334155;
  --ink-2: #475569;
  --ink-3: #64748b;
  --ink-4: #94a3b8;

  /* Status */
  --green:      #16a34a;
  --green-soft: #f0fdf4;
  --green-ring: #bbf7d0;
  --red:        #dc2626;
  --red-soft:   #fef2f2;
  --red-ring:   #fecaca;
  --amber:      #d97706;
  --amber-soft: #fffbeb;

  /* Shadows */
  --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
  --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);

  /* Typography */
  --font: 'Instrument Sans', 'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif;
  --mono: 'JetBrains Mono', 'DM Mono', 'Fira Mono', monospace;

  /* Radii */
  --r-xs: 6px;
  --r-sm: 8px;
  --r-md: 12px;
  --r-lg: 16px;

  /* Border width */
  --bw: 1px;
}

/* =========================================
   2. DESIGN TOKENS — DARK MODE
========================================= */
[data-theme="dark"] {
  color-scheme: dark;

  /* Brand */
  --blue:        #4a72f5;
  --blue-hover:  #3a62e5;
  --blue-soft:   rgba(74, 114, 245, 0.12);
  --blue-ring:   rgba(74, 114, 245, 0.25);

  /* Backgrounds */
  --bg:          #0e0f11;
  --surface:     #141518;
