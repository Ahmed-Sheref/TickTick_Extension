  --ink-1: #c8c8c5;
  --ink-2: #888884;
  --ink-3: #555552;
  --ink-4: #555552;

  /* Status */
  --green:      #22c55e;
  --green-soft: rgba(34, 197, 94, 0.1);
  --green-ring: rgba(34, 197, 94, 0.25);
  --red:        #f87171;
  --red-soft:   rgba(248, 113, 113, 0.1);
  --red-ring:   rgba(248, 113, 113, 0.25);
  --amber:      #eab308;
  --amber-soft: rgba(234, 179, 8, 0.08);

  /* Overrides */
  --shadow-sm: none;
  --shadow-md: none;
  --bw: 1.5px;
}

/* =========================================
