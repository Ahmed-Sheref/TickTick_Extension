{
    --status-accent: var(--green);
    --status-soft: var(--green-soft);

    color: var(--green) !important;
}

#statusBar.status-bar--danger
{
    --status-accent: var(--red);
    --status-soft: var(--red-soft);

    color: var(--red) !important;
}

#statusBar.status-bar--warning
{
