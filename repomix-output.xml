import
{
    randomUUID
}
from "node:crypto";
import ConnectedAccount from "../Models/ConnectedAccount.js";
import notionCredentials from "./notionCredentials.js";
import notionApi from "../utils/notionApi.js";
import
{
    notionFailure
}
from "../utils/notionErrors.js";
import
{
    destinationInput,
    notionId,
    searchInput
}
from "../validators/notionValidator.js";

export const safeNotionUrl = value =>
{
    try
    {
        if (typeof value !== "string" || value.length > 2000) return null;
        const url = new URL(value);
        if (url.protocol !== "https:" || url.username || url.password || url.port ||
            !/(^|\.)(notion\.so|notion\.site|notion\.com)$/.test(url.hostname)) return null;
        return url.href;
    }
    catch
    {
        return null;
    }
};

const titleText = fragments => Array.isArray(fragments) ? fragments.slice(0, 100)
    .map(value => typeof value?.plain_text === "string" ? value.plain_text :
        typeof value?.text?.content === "string" ? value.text.content : "").join("").trim().slice(0, 500) : "";

const normalize = resource =>
{
    const pageTitle = resource.properties && typeof resource.properties === "object" ?
        Object.values(resource.properties).find(value => value?.type === "title")?.title : null;
    const title = titleText(resource.object === "page" ? pageTitle : resource.title);
    return {
        id: notionId(resource.id),
        type: resource.object,
        title: title || (resource.object === "page" ? "Untitled page" : "Untitled data source"),
        url: safeNotionUrl(resource.url),
        lastEditedTime: typeof resource.last_edited_time === "string" && Number.isFinite(Date.parse(resource.last_edited_time)) ?
            resource.last_edited_time : null
    };
};

export const selectedNotionDestination = connection =>
{
    const destination = connection.destination;
    if (!destination) throw notionFailure("NOTION_DESTINATION_REQUIRED");
    if (!notionId(destination.id) || !["page", "data_source"].includes(destination.type) || !notionId(destination.selectionId))
        throw notionFailure("NOTION_DESTINATION_INVALID");
    return {
        id: notionId(destination.id),
        type: destination.type,
        selectionId: notionId(destination.selectionId)
    };
};

export const createNotionDestinationService = (
{
    api = notionApi,
    credentials = notionCredentials,
    ConnectedAccountModel = ConnectedAccount
} = {}) =>
{
    const discover = async (
    {
        userId,
        query = {}
    }) =>
    {
        const body = searchInput(query);
        const
        {
            data
        } = await api.request(
        {
            userId,
            method: "POST",
            path: "/search",
            body
        });
        if (data.object !== "list" || !Array.isArray(data.results) || data.results.length > 50 ||
            typeof data.has_more !== "boolean" || (data.has_more && !notionId(data.next_cursor)) ||
            (!data.has_more && data.next_cursor != null)) throw notionFailure("NOTION_INVALID_RESPONSE");
        const results = [];
        for (const resource of data.results)
        {
            if (!["page", "data_source"].includes(resource?.object)) continue;
            if (!notionId(resource.id)) throw notionFailure("NOTION_INVALID_RESPONSE");
            if (resource.in_trash || resource.is_archived) continue;
            results.push(normalize(resource));
        }
        return {
            destinations: results,
            hasMore: data.has_more,
            nextCursor: data.has_more ? notionId(data.next_cursor) : null
        };
    };

    const verify = async (
    {
        userId,
        destination,
        connection,
        deadline
    }) =>
    {
        let
        {
            id,
            type
        } = destinationInput(
        {
            destinationId: destination?.id,
            destinationType: destination?.type
        });
        let response = await api.request(
        {
            userId,
            method: "GET",
            path: `/${type === "page" ? "pages" : type === "database" ? "databases" : "data_sources"}/${id}`,
            connection,
            deadline
        });
        const assertResource = (data, expectedType, expectedId) =>
        {
            if (data.object !== expectedType || notionId(data.id) !== expectedId) throw notionFailure("NOTION_INVALID_RESPONSE");
            if (data.in_trash || data.is_archived) throw notionFailure("NOTION_DESTINATION_INVALID");
        };
        assertResource(response.data, type, id);
        if (type === "database")
        {
            // Modern databases are containers. Never pick one of several sources.
            if (!Array.isArray(response.data.data_sources) || response.data.data_sources.length !== 1 ||
                !notionId(response.data.data_sources[0]?.id)) throw notionFailure("NOTION_DATABASE_AMBIGUOUS");
            const databaseId = id;
            id = notionId(response.data.data_sources[0].id);
            type = "data_source";
            response = await api.request(
            {
                userId,
                method: "GET",
                path: `/data_sources/${id}`,
                connection: connection || response.connection,
                deadline
            });
            assertResource(response.data, type, id);
            if (notionId(response.data.parent?.database_id) !== databaseId) throw notionFailure("NOTION_INVALID_RESPONSE");
        }
        let titleProperty = null;
        if (type === "data_source")
        {
            const properties = response.data.properties;
            if (!properties || typeof properties !== "object" || Array.isArray(properties)) throw notionFailure("NOTION_SCHEMA_INVALID");
            const titles = Object.entries(properties).filter(([, value]) => value?.type === "title");
            if (titles.length !== 1 || typeof titles[0][1].id !== "string" || !titles[0][1].id.trim() ||
                titles[0][1].id.length > 200 || !titles[0][0].trim()) throw notionFailure("NOTION_SCHEMA_INVALID");
            titleProperty = titles[0][1].id;
        }
        return {
            destination:
            {
                ...normalize(response.data),
                id,
                type
            },
            titleProperty,
            connection: response.connection
        };
    };

    const persist = async (userId, connection, selection) =>
    {
        let updated;
        try
        {
            updated = await ConnectedAccountModel.findOneAndUpdate(
            {
                _id: connection.accountId,
                userId,
                provider: "notion",
                connected: true,
                providerAccountId: connection.providerAccountId,
                encryptedAccessToken: connection.credentialVersion
            },
            {
                $set:
                {
                    "metadata.notionDestination": selection
                }
            },
            {
                new: true,
                runValidators: true
            }).select("_id");
        }
        catch
        {
            throw notionFailure("NOTION_PERSISTENCE_FAILED");
        }
        if (!updated) throw notionFailure("NOTION_CONNECTION_CHANGED");
    };
    const select = async (
    {
        userId,
        body
    }) =>
    {
        const verified = await verify(
        {
            userId,
            destination: destinationInput(body)
        });
        await persist(userId, verified.connection,
        {
            id: verified.destination.id,
            type: verified.destination.type,
            selectionId: randomUUID()
        });
        return {
            destination: verified.destination
        };
    };
    const getSelection = async (
    {
        userId
    }) =>
    {
        const
        {
            connection
        } = await credentials.getForUser(
        {
            userId
        });
        if (!connection.destination) return {
            destination: null
        };
        const
        {
            id,
            type
        } = selectedNotionDestination(connection);
        return {
            destination:
            {
                id,
                type
            }
        };
    };
    const clear = async (
    {
        userId
    }) =>
    {
        const
        {
            connection
        } = await credentials.getForUser(
        {
            userId
        });
        await persist(userId, connection, null);
        return {
            destination: null
        };
    };
    return {
        discover,
        verify,
        select,
        getSelection,
        clear
    };
};

export default createNotionDestinationService();
</file>

<file path="services/notionLinkService.js">
import { createHash, randomBytes } from "node:crypto";
import User from "../Models/User.js";
import AuthIdentity from "../Models/AuthIdentity.js";
import ConnectedAccount from "../Models/ConnectedAccount.js";
import NotionLinkState from "../Models/NotionLinkState.js";
import { assertTokenEncryptionConfigured, encryptProviderToken } from "../utils/providerTokenEncryption.js";
import { getNotionLinkConfig, getNotionLinkAuthUrl, exchangeNotionLinkCode,
    validateNotionTokens } from "../utils/notionLinkOAuth.js";

const failure = code => Object.assign(new Error(code), { code });
const hashState = state => createHash("sha256").update(state).digest("hex");
const allowedRedirects = () => (process.env.ALLOWED_EXTENSION_REDIRECT_URIS || "")
    .split(",").map(value => value.trim()).filter(Boolean);

export const validateExtensionRedirect = (redirectUri, allowlist) =>
{
    try
    {
        const url = new URL(redirectUri);
        if (typeof redirectUri !== "string" || !allowlist.includes(redirectUri) || url.protocol !== "https:" ||
            url.username || url.password || url.search || url.hash || url.port ||
            !/^[a-z0-9-]+\.chromiumapp\.org$/.test(url.hostname))
        {
            throw new Error();
        }
    }
    catch
    {
        throw failure("INVALID_LINK_PARAMETERS");
    }
};

export const notionIdentity = tokens =>
{
    validateNotionTokens(tokens);
    // UUID normalization prevents equivalent case variants from evading uniqueness.
    return `workspace:${tokens.workspace_id.toLowerCase()}:user:${tokens.owner.user.id.toLowerCase()}`;
};

export const encryptNotionPair = (tokens, userId) =>
{
    const access = encryptProviderToken(tokens.access_token, { userId, provider: "notion", tokenType: "access" });
    const refresh = encryptProviderToken(tokens.refresh_token, { userId, provider: "notion", tokenType: "refresh" });
    return { encryptedAccessToken: access.encryptedToken, encryptedRefreshToken: refresh.encryptedToken,
        tokenKeyId: access.keyId, tokenEncryptedAt: new Date() };
};

export const createNotionLinkService = (dependencies = {}) =>
{
    const { UserModel = User, AuthIdentityModel = AuthIdentity, ConnectedAccountModel = ConnectedAccount,
        StateModel = NotionLinkState, getConfig = getNotionLinkConfig, getAuthUrl = getNotionLinkAuthUrl,
        exchangeCode = exchangeNotionLinkCode, getAllowedRedirects = allowedRedirects } = dependencies;

    const requireGoogleIdentity = async userId =>
    {
        if (!await AuthIdentityModel.exists({ userId, provider: "google" }))
        {
            throw failure("GOOGLE_IDENTITY_REQUIRED");
        }
    };

    const startLink = async ({ userId, redirectUri, clientNonce }) =>
    {
        await requireGoogleIdentity(userId);
        validateExtensionRedirect(redirectUri, getAllowedRedirects());
        if (typeof clientNonce !== "string" || !/^[A-Za-z0-9_-]{32,128}$/.test(clientNonce))
        {
            throw failure("INVALID_LINK_PARAMETERS");
        }
        assertTokenEncryptionConfigured();
        const config = getConfig();
        const state = randomBytes(32).toString("base64url");
        const authorizationUrl = getAuthUrl(state, config.redirectUri);
        await StateModel.create({ stateHash: hashState(state), userId, extensionRedirectUri: redirectUri,
            clientNonce, providerRedirectUri: config.redirectUri, expiresAt: new Date(Date.now() + 600000) });
        return { authorizationUrl };
    };

    const completeLink = async ({ state, code, providerError }) =>
    {
        if (typeof state !== "string" || !/^[A-Za-z0-9_-]{43}$/.test(state))
        {
            throw failure("INVALID_LINK_STATE");
        }
        const attempt = await StateModel.findOneAndDelete({ stateHash: hashState(state), expiresAt: { $gt: new Date() } });
        if (!attempt)
        {
            throw failure("INVALID_LINK_STATE");
        }
        if (providerError !== undefined || typeof code !== "string" || !code.trim() || code.length > 4096)
        {
            throw failure("NOTION_LINK_CANCELLED");
        }
        validateExtensionRedirect(attempt.extensionRedirectUri, getAllowedRedirects());
        if (!await UserModel.exists({ userId: attempt.userId }))
        {
            throw failure("LINK_USER_NOT_FOUND");
        }
        await requireGoogleIdentity(attempt.userId);
        assertTokenEncryptionConfigured();
        const tokens = await exchangeCode(code, attempt.providerRedirectUri);
        const providerAccountId = notionIdentity(tokens);
        const owner = await ConnectedAccountModel.findOne({ provider: "notion", providerAccountId });
        if (owner && owner.userId !== attempt.userId)
        {
            throw failure("NOTION_ACCOUNT_CONFLICT");
        }
        const values = { ...encryptNotionPair(tokens, attempt.userId), providerAccountId, connected: true,
            notionRefreshLock: null,
            // Replace destination metadata together: never retain a prior workspace's selections.
            metadata: { workspaceId: tokens.workspace_id.toLowerCase(), workspaceName: tokens.workspace_name ?? null,
                workspaceIcon: tokens.workspace_icon ?? null, authorizingUserId: tokens.owner.user.id.toLowerCase(),
                botId: tokens.bot_id.toLowerCase(), reconnectRequired: false } };
        try
        {
            const updated = await ConnectedAccountModel.findOneAndUpdate(
                { userId: attempt.userId, provider: "notion" },
                { $set: values, $setOnInsert: { userId: attempt.userId, provider: "notion" } },
                { upsert: true, new: true, runValidators: true });
            if (!updated)
            {
                throw failure("NOTION_ACCOUNT_CONFLICT");
            }
        }
        catch (error)
        {
            if (error?.code === 11000)
            {
                throw failure("NOTION_ACCOUNT_CONFLICT");
            }
            throw error;
        }
        const redirect = new URL(attempt.extensionRedirectUri);
        redirect.search = new URLSearchParams({ notion_link: "connected", client_nonce: attempt.clientNonce }).toString();
        return { redirectUrl: redirect.toString() };
    };

    const getStatus = async ({ userId }) =>
    {
        await requireGoogleIdentity(userId);
        const account = await ConnectedAccountModel.findOne({ userId, provider: "notion" });
        return { connected: Boolean(account?.connected), reconnectRequired: Boolean(account?.metadata?.reconnectRequired),
            workspaceName: account?.metadata?.workspaceName ?? null, workspaceIcon: account?.metadata?.workspaceIcon ?? null };
    };

    return { startLink, completeLink, getStatus };
};

export default createNotionLinkService();
</file>

<file path="services/ticktickContentService.js">
import
{
    randomUUID
}
from "node:crypto";
import Content from "../Models/Content.js";
import
{
    getTickTickAccessToken
}
from "./ticktickCredentials.js";
import
{
    createTickTickTask,
    getTickTickProjects
}
from "../utils/ticktick.js";
import normalizeTags from "../utils/normTags.js";

export const ticktickFailure = (code, statusCode = 409) => Object.assign(new Error(
{
    TICKTICK_NOT_REQUESTED: "TickTick was not requested for this capture",
    TICKTICK_NOT_CONNECTED: "Connect TickTick before retrying",
    TICKTICK_PROJECT_UNAVAILABLE: "The selected TickTick list is unavailable. Review it in TickTick before retrying",
    TICKTICK_SYNC_IN_PROGRESS: "TickTick synchronization is already claimed; interrupted attempts need review",
    TICKTICK_SYNC_UNCERTAIN: "A TickTick write may have completed. Review TickTick before retrying",
    TICKTICK_SYNC_FAILED: "TickTick synchronization failed",
    CONTENT_NOT_FOUND: "Content was not found for this account"
} [code] || "TickTick synchronization failed"),
{
    code,
    statusCode
});

export const createTickTickContentService = (
{
    ContentModel = Content,
    getToken = getTickTickAccessToken,
    createTask = createTickTickTask,
    getProjects = getTickTickProjects,
    analyze = async text => (await import("../utils/generativeAI.js")).default(text)
} = {}) =>
{
    const syncContent = async (
    {
        userId,
        contentId
    }) =>
    {
        if (!/^[a-f0-9]{24}$/i.test(String(contentId))) throw ticktickFailure("CONTENT_NOT_FOUND", 404);
        const owner = {
            _id: contentId,
            userId
        };
        const content = await ContentModel.findOne(owner).select("+integrations.ticktick.claim");
        if (!content || content.userId !== userId) throw ticktickFailure("CONTENT_NOT_FOUND", 404);
        const state = content.integrations?.ticktick ||
        {};
        if (state.status === "synced" && state.taskId) return {
            status: "synced",
            taskId: state.taskId
        };
        // Compatibility read only when the modern execution state is absent.
        if (content.integrations?.tickTickId && !state.status)
            return {
                status: "synced",
                taskId: content.integrations.tickTickId
            };
        if (!content.destinations?.ticktick?.enabled) throw ticktickFailure("TICKTICK_NOT_REQUESTED");
        if (state.status === "uncertain") throw ticktickFailure("TICKTICK_SYNC_UNCERTAIN");
        if (state.claim || state.status === "pending") throw ticktickFailure("TICKTICK_SYNC_IN_PROGRESS");
        const claim = randomUUID();
        const claimed = await ContentModel.findOneAndUpdate(
        {
            ...owner,
            "destinations.ticktick.enabled": true,
            "integrations.ticktick.claim": null,
            "integrations.ticktick.status":
            {
                $nin: ["pending", "synced", "uncertain"]
            }
        },
        {
            $set:
            {
                "integrations.ticktick.status": "pending",
                "integrations.ticktick.claim": claim,
                "integrations.ticktick.phase": "preparing",
                "integrations.ticktick.errorCode": null,
                "integrations.ticktick.lastAttemptAt": new Date()
            }
        },
        {
            new: true,
            runValidators: true
        }).select("_id");
        if (!claimed) throw ticktickFailure("TICKTICK_SYNC_IN_PROGRESS");
        const persist = async values =>
        {
            const updated = await ContentModel.findOneAndUpdate(
            {
                ...owner,
                "integrations.ticktick.claim": claim,
                "integrations.ticktick.status": "pending"
            },
            {
                $set: Object.fromEntries(Object.entries(values).map(([key, value]) => [`integrations.ticktick.${key}`, value]))
            },
            {
                new: true,
                runValidators: true
            }).select("_id");
            if (!updated) throw new Error("Sync persistence failed");
        };
        let writing = false;
        try
        {
            const token = await getToken(userId);
            if (!token) throw ticktickFailure("TICKTICK_NOT_CONNECTED");
            const projects = await getProjects(token);
            if (!Array.isArray(projects) || !projects.some(project => project?.id === content.destinations.ticktick.projectId))
                throw ticktickFailure("TICKTICK_PROJECT_UNAVAILABLE");
            const options = content.destinations.ticktick.options ||
            {};
            let tags = normalizeTags(options.tags || []);
            let summary = null;
            let aiStatus = "not_requested";
            if (options.useAiSummary || options.useAiTags)
            {
                aiStatus = "failed";
                try
                {
                    const generated = await analyze(content.rawText);
                    if (options.useAiSummary && typeof generated.summary === "string" && generated.summary.trim()) summary = generated.summary.slice(0, 20000);
                    if (options.useAiTags && Array.isArray(generated.ai_tags)) tags = normalizeTags([...tags, ...generated.ai_tags.filter(tag => typeof tag === "string").slice(0, 30)]);
                    if ((!options.useAiSummary || summary) && (!options.useAiTags || Array.isArray(generated.ai_tags) && generated.ai_tags.some(tag => typeof tag === "string" && tag.trim()))) aiStatus = "generated";
                }
                catch
                {
                    /* Keep original capture; never fabricate AI output. */
                }
            }
            await persist(
            {
                phase: "creating",
                summary,
                tags,
                aiStatus
            });
            writing = true;
            const task = await createTask(token,
            {
                title: content.title,
                rawText: summary ? options.mergeSummaryWithContent ? `${content.rawText}\n\nSummary:\n${summary}` : summary : content.rawText,
                tags,
                projectId: content.destinations.ticktick.projectId || undefined
            });
            if (typeof task?.id !== "string" || !/^[a-zA-Z0-9_-]{1,100}$/.test(task.id)) throw new Error("Invalid task acknowledgement");
            const updated = await ContentModel.findOneAndUpdate(
            {
                ...owner,
                "integrations.ticktick.claim": claim,
                "integrations.ticktick.status": "pending"
            },
            {
                $set:
                {
                    "integrations.ticktick.status": "synced",
                    "integrations.ticktick.claim": null,
                    "integrations.ticktick.phase": "complete",
                    "integrations.ticktick.taskId": task.id,
                    // Keep compatibility aliases in the same claimed acknowledgement.
                    // Removing dual writes requires a separate consumer/data migration.
                    "integrations.tickTickId": task.id,
                    "integrations.tickTickProjectId": content.destinations.ticktick.projectId || null
                }
            },
            {
                new: true,
                runValidators: true
            }).select("_id");
            if (!updated) throw new Error("Sync persistence failed");
            return {
                status: "synced",
                taskId: task.id
            };
        }
        catch (error)
        {
            // Never reclaim a lost write acknowledgement, 5xx, or failed persistence.
            const definitive = [400, 401, 403, 404, 422, 429].includes(error?.response?.status);
            const uncertain = writing && !definitive;
            const code = uncertain ? "TICKTICK_SYNC_UNCERTAIN" : ["TICKTICK_NOT_CONNECTED", "TICKTICK_PROJECT_UNAVAILABLE"].includes(error?.code) ? error.code : "TICKTICK_SYNC_FAILED";
            try
            {
                await persist(
                {
                    status: uncertain ? "uncertain" : "failed",
                    claim: uncertain ? claim : null,
                    errorCode: code
                });
            }
            catch
            {
                /* Durable claim still prevents unsafe repeat writes. */
            }
            throw ticktickFailure(code);
        }
    };
    return {
        syncContent
    };
};

export default createTickTickContentService();
</file>

<file path="services/ticktickCredentials.js">
import User from "../Models/User.js";
import ConnectedAccount from "../Models/ConnectedAccount.js";
import { decryptProviderToken } from "../utils/providerTokenEncryption.js";

// New encrypted links take precedence. Legacy credentials remain readable;
// this resolver never copies, rotates, deletes, or writes provider tokens.
export const getTickTickAccessToken = async (userId, legacyUser) =>
{
    const account = await ConnectedAccount.findOne({ userId, provider: "ticktick" })
        .select("+encryptedAccessToken");
    // Phase-1 placeholder rows had no credentials and were ignored by legacy
    // readers. Preserve that behavior; only an active/encrypted row takes over.
    if (account && (account.connected || account.encryptedAccessToken))
    {
        if (!account.connected)
        {
            return null;
        }
        if (account.encryptedAccessToken?.split(".")[1] !== account.tokenKeyId)
        {
            const error = new Error("Provider token could not be decrypted");
            error.statusCode = 503;
            throw error;
        }
        return decryptProviderToken(account.encryptedAccessToken,
            { userId, provider: "ticktick", tokenType: "access" });
    }
    const user = legacyUser === undefined ? await User.findOne({ userId }) : legacyUser;
    return user?.tickTickConnected && user?.tickTickAccessToken ? user.tickTickAccessToken : null;
};
</file>

<file path="services/ticktickLinkService.js">
import { createHash, randomBytes } from "node:crypto";
import User from "../Models/User.js";
import AuthIdentity from "../Models/AuthIdentity.js";
import ConnectedAccount from "../Models/ConnectedAccount.js";
import TickTickLinkState from "../Models/TickTickLinkState.js";
import { assertTokenEncryptionConfigured, encryptProviderToken } from "../utils/providerTokenEncryption.js";
import { getTickTickLinkConfig, getTickTickLinkAuthUrl, exchangeTickTickLinkCode } from "../utils/ticktickLinkOAuth.js";
import { assertTickTickFingerprintConfigured, fingerprintTickTickCredential } from "../utils/ticktickCredentialFingerprint.js";

const failure = (code) =>
{
    const error = new Error(code);
    error.code = code;
    return error;
};
const hashState = state => createHash("sha256").update(state).digest("hex");
const allowedRedirects = () => (process.env.ALLOWED_EXTENSION_REDIRECT_URIS || "")
    .split(",").map(value => value.trim()).filter(Boolean);

export const createTickTickLinkService = (dependencies = {}) =>
{
    const {
        UserModel = User,
        AuthIdentityModel = AuthIdentity,
        ConnectedAccountModel = ConnectedAccount,
        StateModel = TickTickLinkState,
        getConfig = getTickTickLinkConfig,
        getAuthUrl = getTickTickLinkAuthUrl,
        exchangeCode = exchangeTickTickLinkCode,
        getAllowedRedirects = allowedRedirects
    } = dependencies;

    const requireGoogleIdentity = async (userId) =>
    {
        if (!await AuthIdentityModel.exists({ userId, provider: "google" }))
        {
            throw failure("GOOGLE_IDENTITY_REQUIRED");
        }
    };

    const startLink = async ({ userId, redirectUri, clientNonce }) =>
    {
        await requireGoogleIdentity(userId);
        if (typeof redirectUri !== "string" || !getAllowedRedirects().includes(redirectUri) ||
            typeof clientNonce !== "string" || !/^[A-Za-z0-9_-]{32,128}$/.test(clientNonce))
        {
            throw failure("INVALID_LINK_PARAMETERS");
        }
        try
        {
            const url = new URL(redirectUri);
            if (url.username || url.password || url.search || url.hash ||
                (url.protocol !== "https:" && !(url.protocol === "http:" && ["localhost", "127.0.0.1"].includes(url.hostname))))
            {
                throw new Error();
            }
        }
        catch
        {
            throw failure("INVALID_LINK_PARAMETERS");
        }
        assertTokenEncryptionConfigured();
        assertTickTickFingerprintConfigured();
        const config = getConfig();
        const state = randomBytes(32).toString("base64url");
        const authorizationUrl = getAuthUrl(state, config.redirectUri);
        await StateModel.create({
            stateHash: hashState(state), userId, extensionRedirectUri: redirectUri,
            clientNonce, providerRedirectUri: config.redirectUri,
            expiresAt: new Date(Date.now() + 10 * 60 * 1000)
        });
        return { authorizationUrl };
    };

    const completeLink = async ({ state, code, providerError }) =>
    {
        if (typeof state !== "string" || !/^[A-Za-z0-9_-]{43}$/.test(state))
        {
            throw failure("INVALID_LINK_STATE");
        }
        // Atomic consumption provides single use, independent of MongoDB TTL cleanup.
        const attempt = await StateModel.findOneAndDelete({
            stateHash: hashState(state), expiresAt: { $gt: new Date() }
        });
        if (!attempt)
        {
            throw failure("INVALID_LINK_STATE");
        }
        if (providerError || typeof code !== "string" || !code.trim() || code.length > 4096)
        {
            throw failure("TICKTICK_LINK_CANCELLED");
        }
        if (!getAllowedRedirects().includes(attempt.extensionRedirectUri))
        {
            throw failure("INVALID_LINK_PARAMETERS");
        }
        if (!await UserModel.exists({ userId: attempt.userId }))
        {
            throw failure("LINK_USER_NOT_FOUND");
        }
        await requireGoogleIdentity(attempt.userId);
        assertTokenEncryptionConfigured();
        assertTickTickFingerprintConfigured();
        const tokens = await exchangeCode(code, attempt.providerRedirectUri);
        const credentialFingerprint = fingerprintTickTickCredential(tokens.access_token);
        const owner = await ConnectedAccountModel.findOne({ provider: "ticktick", credentialFingerprint });
        if (owner && owner.userId !== attempt.userId)
        {
            throw failure("TICKTICK_ACCOUNT_CONFLICT");
        }
        const access = encryptProviderToken(tokens.access_token,
            { userId: attempt.userId, provider: "ticktick", tokenType: "access" });
        const refresh = tokens.refresh_token ? encryptProviderToken(tokens.refresh_token,
            { userId: attempt.userId, provider: "ticktick", tokenType: "refresh" }) : null;
        const values = {
            // Reauthorization can select a different destination. The old ID
            // cannot verify that new account, so clear it in the same write.
            providerAccountId: null,
            credentialFingerprint,
            connected: true, encryptedAccessToken: access.encryptedToken,
            encryptedRefreshToken: refresh?.encryptedToken ?? null,
            tokenKeyId: access.keyId, tokenEncryptedAt: new Date()
        };
        try
        {
            // A single owner-scoped upsert creates the first connection or
            // atomically replaces all credentials on that user's existing row.
            // Unique indexes, not the precheck, arbitrate concurrent claims.
            const updated = await ConnectedAccountModel.findOneAndUpdate(
                { userId: attempt.userId, provider: "ticktick" },
                {
                    $set: values,
                    $setOnInsert: { userId: attempt.userId, provider: "ticktick" }
                },
                { upsert: true, new: true, runValidators: true }
            );
            if (!updated)
            {
                throw failure("TICKTICK_ACCOUNT_CONFLICT");
            }
        }
        catch (error)
        {
            if (error?.code === 11000)
            {
                throw failure("TICKTICK_ACCOUNT_CONFLICT");
            }
            throw error;
        }
        const redirect = new URL(attempt.extensionRedirectUri);
        redirect.searchParams.set("ticktick_link", "connected");
        redirect.searchParams.set("client_nonce", attempt.clientNonce);
        return { redirectUrl: redirect.toString() };
    };

    return { startLink, completeLink };
};

export default createTickTickLinkService();
</file>

<file path="services/weeklyEmailService.js">
import User from "../Models/User.js";
import Content from "../Models/Content.js";
import { sendWeeklyEmail } from "../utils/email.js";

const getUsersForWeeklyEmail = async () =>
{
    return User.find(
    {
        weeklyEmailEnabled: true,
        email: { $exists: true, $ne: null }
    });
};

const getOneWeekAgo = () =>
{
    const oneWeekAgo = new Date();
    oneWeekAgo.setDate(oneWeekAgo.getDate() - 7);

    return oneWeekAgo;
};

const getWeeklyEmailContents = async (userId) =>
{
    const oneWeekAgo = getOneWeekAgo();

    return Content.find(
    {
        userId,
        "options.includeInWeeklyEmail": true,
        summary: { $ne: null },
        lastEmailedAt: null,
        createdAt: { $gte: oneWeekAgo }
    })
    .sort({ createdAt: -1 });
};

const markContentsAsEmailed = async (contents) =>
{
    await Content.updateMany(
        {
            _id:
            {
                $in: contents.map(content => content._id)
            }
        },
        {
            $set:
            {
                lastEmailedAt: new Date()
            }
        }
    );
};

const sendWeeklyEmailToUser = async (user) =>
{
    const contents = await getWeeklyEmailContents(user.userId);

    if (contents.length === 0)
    {
        console.log(`[EMAIL] No articles for ${user.email} this week`);
        return;
    }

    await sendWeeklyEmail(user.email, contents);

    await markContentsAsEmailed(contents);

    console.log(`[EMAIL] Weekly email sent to ${user.email}`);
};

const sendWeeklyEmails = async () =>
{
    console.log("[EMAIL] Starting weekly email job.");

    const users = await getUsersForWeeklyEmail();

    console.log(`[EMAIL] Found ${users.length} users to send emails`);

    for (const user of users)
    {
        try
        {
            await sendWeeklyEmailToUser(user);
        }
        catch (userError)
        {
            console.error(`[EMAIL] Failed for ${user.email}:`, userError.message);
        }
    }

    console.log("[EMAIL] Weekly email job completed.");
};

export default {
    sendWeeklyEmails
};
</file>

<file path="services/weeklyQuizService.js">
import User from "../Models/User.js";
import Content from "../Models/Content.js";
import QuizPoll from "../Models/QuizPoll.js";
import bot from "../utils/telegramBot.js";

const getUsersForWeeklyQuiz = async () =>
{
    return User.find(
    {
        receiveTelegramQuiz: true,
        telegramChatId: { $exists: true, $ne: null }
    });
};

const getUnsolvedQuizContents = async (userId) =>
{
    return Content.find(
    {
        userId,
        "quiz.question": { $exists: true },
        "quiz.isSolved": false,
        "options.includeInTelegramQuiz": true
    })
    .sort({ createdAt: -1 })
    .limit(3);
};

const isValidQuiz = (content) =>
{
    if (!content.quiz?.options || content.quiz.options.length < 2)
    {
        return false;
    }

    const correctOptionIndex = content.quiz.options.indexOf(content.quiz.correctAnswer);

    return correctOptionIndex !== -1;
};

const getCorrectOptionIndex = (content) =>
{
    return content.quiz.options.indexOf(content.quiz.correctAnswer);
};

const sendNoQuizzesMessage = async (user) =>
{
    await bot.sendMessage(
        user.telegramChatId,
        "🎉 You solved all your quizzes this week! Save more articles to get new ones."
    );
};

const sendQuizIntroMessage = async (user, quizCount) =>
{
    await bot.sendMessage(
        user.telegramChatId,
        `🧠 *Weekly Quiz Time!*\nYou have ${quizCount} question(s) to answer:`,
        { parse_mode: "Markdown" }
    );
};

const createQuizPollRecord = async ({ poll, content, user }) =>
{
    await QuizPoll.create(
    {
        pollId: poll.poll.id,
        contentId: content._id,
        userId: user.userId,
        chatId: user.telegramChatId,
        isAnswered: false,
        sentAt: new Date()
    });
};

const sendQuizPoll = async ({ user, content }) =>
{
    if (!isValidQuiz(content))
    {
        console.log(`[QUIZ] Invalid quiz for content: ${content._id}`);
        return;
    }

    const correctOptionIndex = getCorrectOptionIndex(content);

    const poll = await bot.sendPoll(
        user.telegramChatId,
        content.quiz.question,
        content.quiz.options,
        {
            type: "quiz",
            correct_option_id: correctOptionIndex,
            is_anonymous: false,
            explanation: `From article: ${content.title}`
        }
    );

    await createQuizPollRecord(
    {
        poll,
        content,
        user
    });

    console.log(`[QUIZ] Quiz sent for: ${content.title}`);
};

const sendQuizzesToUser = async (user) =>
{
    const contents = await getUnsolvedQuizContents(user.userId);

    if (contents.length === 0)
    {
        console.log(`[QUIZ] No unsolved quizzes for ${user.userId}`);
        await sendNoQuizzesMessage(user);
        return;
    }

    await sendQuizIntroMessage(user, contents.length);

    for (const content of contents)
    {
        await sendQuizPoll(
        {
            user,
            content
        });
    }
};

const sendWeeklyQuizzes = async () =>
{
    console.log("[QUIZ] Starting weekly quiz job...");

    const users = await getUsersForWeeklyQuiz();

    console.log(`[QUIZ] Found ${users.length} users to send quiz`);

    for (const user of users)
    {
        try
        {
            await sendQuizzesToUser(user);
        }
        catch (userError)
        {
            console.error(`[QUIZ] Failed for ${user.userId}:`, userError.message);
        }
    }

    console.log("[QUIZ] Weekly quiz job completed");
};

const handlePollAnswer = async (answer) =>
{
    console.log("[QUIZ] Poll answer received for poll:", answer.poll_id);

    const quizPoll = await QuizPoll.findOne({ pollId: answer.poll_id });

    if (!quizPoll)
    {
        console.log("[QUIZ] No poll found for ID:", answer.poll_id);
        return;
    }

    if (quizPoll.isAnswered)
    {
        console.log("[QUIZ] Poll already answered:", answer.poll_id);
        return;
    }

    await Promise.all(
    [
        QuizPoll.findByIdAndUpdate(
            quizPoll._id,
            {
                isAnswered: true,
                answeredAt: new Date()
            }
        ),
        Content.findByIdAndUpdate(
            quizPoll.contentId,
            {
                "quiz.isSolved": true
            }
        )
    ]);

    console.log(`[QUIZ] Quiz solved for content: ${quizPoll.contentId}`);
};

export default 
{
    sendWeeklyQuizzes,
    handlePollAnswer
};
</file>

