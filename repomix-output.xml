   Labels, helper text, and surrounding form whitespace are not part
   of the dropdown hit area anymore. */

#projectField
.project-search-box,
#tagsField
.tags-input-box
{
    position: relative !important;
}

#projectField
.project-search-box::after,
#tagsField
.tags-input-box::after
