<file path="extension/v2.css">
/* Approved V2 tokens and geometry. Existing controls keep their API bindings. */
:root {
  --ink-0:#13294b; --ink-1:#13294b; --ink-2:#63738b; --ink-3:#63738b; --ink-4:#8997a9;
  --surface:#fff; --bg:#f5f8fb; --bg-3:#fafcfd; --bg-4:#d4dce6;
  --border:#dbe4ec; --border-soft:#e9eef3;
  --blue:#076e7b; --blue-hover:#075c68; --blue-soft:#e6f3f4; --blue-ring:#a7d7de;
  --action:#087b89; --action-hover:#075c68; --green:#167c63; --red:#b44343;
}
[data-theme="dark"] {
  --surface:#152136; --bg:#0d1626; --bg-3:#1a2941; --bg-4:#34435b;
  --border:#32425c; --border-soft:#26364e; --ink-0:#f0f4fc; --ink-1:#dce5f5; --ink-2:#b4c1d8; --ink-3:#9cacc7; --ink-4:#9cacc7;
  --blue:#77d3da; --blue-hover:#a8e7eb; --blue-soft:#183c44; --blue-ring:#59a4ad; --action:#087b89; --action-hover:#096c78;
  --green:#92dbb7; --green-soft:#1c3c34; --red:#ffb0c1; --red-soft:#402637;
}
html { width:100%; height:100dvh; }
.shell { padding:0; max-width:1270px; margin-inline:auto; }
#appView { border-radius:24px; overflow:hidden; background:var(--surface); }
.popup-header { min-height:87px; padding:17px 30px 12px 32px; gap:18px; border:0; }
.v2-wordmark { display:block; width:176px; height:auto; object-fit:contain; }
.brand-lockup { width:auto; }
.header-actions { gap:18px; }
.main-scroll { padding:12px 32px 14px; }
#panelSave { display:block; }
.settings-active #panelSave { display:none; }
.v2-composition { display:grid; grid-template-columns:1.03fr .97fr; gap:26px; align-items:start; }
.v2-editor { min-width:0; }
.v2-intro h1 { font-size:31px; line-height:1.18; letter-spacing:-.9px; font-weight:800; margin:3px 0 6px; color:var(--ink-0); }
.v2-intro p { color:var(--ink-3); font-size:15px; line-height:1.5; margin-bottom:18px; }
#captureEditor { display:block; padding:0; border:0; background:transparent; margin:0; }
.editor-heading { display:none; }
#captureEditor > .label, #captureEditor .label-with-meta .label { font-size:13px; font-weight:680; color:var(--ink-0); margin:0 0 9px; }
#captureEditor .input { height:45px; font-size:16px; border-radius:11px; padding:12px 15px; }
.v2-title-wrap { position:relative; }
#captureEditor #title { padding-right:66px; }
.v2-title-count { position:absolute; right:13px; top:15px; color:var(--ink-4); font-size:11px; pointer-events:none; }
#captureEditor .textarea { height:104px; min-height:104px; max-height:260px; font-size:16px; line-height:1.6; padding:12px 15px; resize:vertical; border-radius:11px; }
#captureEditor .label-with-meta { margin:17px 0 0; align-items:baseline; }
#captureEditor .ai-block { display:none; }
.v2-field-error { font-size:12px; color:var(--red); margin-top:6px; }
.v2-metadata { display:grid; grid-template-columns:1.02fr .98fr; gap:20px; margin-top:20px; }
.v2-metadata h2, #tagsFieldLabel { font-size:13px; font-weight:680; margin:0 0 9px; color:var(--ink-0); }
.v2-upload { display:flex; align-items:center; gap:11px; min-height:58px; padding:12px 13px; width:100%; border:1px dashed #bacbd5; border-radius:12px; background:var(--bg-3); text-align:left; color:var(--ink-0); opacity:1; cursor:not-allowed; }
.v2-upload { line-height:1.25; }
.v2-upload > svg { color:var(--blue); width:22px; height:22px; }
.v2-upload strong { display:block; font-size:13px; }
.v2-upload small { display:block; font-size:11px; color:var(--ink-3); margin-top:2px; }
.v2-upload .v2-upload-plus { margin-left:auto; font-size:20px; color:var(--ink-3); }
#attachmentSupport { font-size:10px; line-height:1.45; color:var(--ink-3); margin-top:8px; }
.v2-metadata #tagsField { margin:0; }
.tags-input-box { border:0; background:transparent; padding:0; box-shadow:none!important; min-height:30px; }
.tags-input-box > .picker-leading-icon, #tagPickerToggleBtn { display:none; }
.tags-picker-value { display:flex; flex-wrap:wrap; align-items:center; gap:7px; }
.selected-tags-container { display:contents; }
.tag-chip, .v2-preview-tag { display:inline-flex; align-items:center; gap:7px; border:0; border-radius:100px; padding:7px 11px; background:var(--blue-soft); color:var(--blue-hover); font-size:12px; line-height:1.2; font-weight:600; max-width:170px; }
.tag-chip-remove { color:var(--blue-hover); width:16px; height:16px; min-width:16px; }
.v2-add-tag { background:var(--surface); border:1px solid var(--border); color:var(--ink-0); padding:7px 12px; border-radius:100px; font-size:12px; font-weight:600; }
#tagInput { border:1px solid var(--border); border-radius:8px; min-width:100px; width:150px; height:33px; padding:6px 10px; font-size:12px; }
.tags-picker-value:not(.is-editing) #tagInput { position:absolute; width:1px; height:1px; padding:0; opacity:0; clip-path:inset(50%); }
.tags-picker-value:focus-within #tagInput { position:static; width:150px; height:33px; padding:6px 10px; opacity:1; clip-path:none; }
.v2-inclusion, .v2-source { font-size:11px; color:var(--ink-3); margin-top:8px; }
.v2-editor-extras { display:flex; flex-wrap:wrap; gap:0 18px; }
.v2-editor-extras details[open] { flex-basis:100%; }
.v2-inclusion summary, .v2-source summary { cursor:pointer; padding:3px 0; }
.v2-source > label { display:none; }
.v2-source[open] > input { margin-top:6px; }
.article-preview { display:block; padding:18px 20px 17px; margin:0; border-radius:17px; border:1px solid var(--border-soft); background:var(--surface); box-shadow:0 9px 20px rgb(26 54 85 / 4%); }
.v2-preview-head { display:flex; justify-content:space-between; align-items:center; gap:12px; margin-bottom:16px; font-size:14px; font-weight:750; }
.v2-preview-head span { font-size:12px; font-weight:600; padding:10px 15px; border:1px solid var(--border); border-radius:11px; }
.preview-cover { width:100%; height:169px; border-radius:11px; margin-bottom:16px; }
.preview-cover:has(img[hidden]) { display:none; }
.article-preview-copy { padding-right:0; }
.article-preview-copy h2 { font-size:21px; line-height:1.23; letter-spacing:-.5px; font-weight:750; -webkit-line-clamp:3; margin:0 0 7px; }
.article-preview-copy > p { font-size:14px; line-height:1.65; -webkit-line-clamp:4; margin:0 0 13px; }
.preview-source { margin-top:8px; padding-right:30px; }
.article-preview:has(#previewImage:not([hidden])) .preview-source { display:none; }
.preview-actions { top:auto; bottom:15px; right:15px; }
.v2-preview-tags { display:flex; flex-wrap:wrap; gap:7px; margin-top:14px; padding-right:28px; }
.v2-preview-tags:empty { display:none; }
.v2-destinations { margin-top:18px; }
.v2-dest-heading { display:flex; justify-content:space-between; align-items:end; gap:20px; margin-bottom:14px; }
.v2-dest-heading h2 { font-size:23px; line-height:1.3; letter-spacing:-.45px; color:var(--ink-0); margin-bottom:4px; }
.v2-dest-heading p { font-size:14px; color:var(--ink-3); }
.v2-dest-heading button { flex:none; }
#managePlatformsBtn svg { width:15px; height:15px; }
.v2-destination-list { display:grid; gap:10px; }
.v2-destination-row { display:grid; grid-template-columns:30px 315px minmax(0,1fr); gap:12px; align-items:center; padding:11px 15px; border:1px solid #d5e4e7; border-radius:14px; box-shadow:0 2px 12px rgb(36 62 91 / 2.5%); }
.v2-reorder { display:flex; flex-direction:column; align-items:center; gap:1px; }
.drag-handle { font-size:21px; color:#8b9eae; cursor:grab; line-height:20px; }
.v2-reorder button { height:23px; min-width:26px; padding:0; background:transparent; border:0; color:var(--blue-hover); border-radius:6px; font-size:19px; }
.v2-reorder button:disabled { display:none; }
.v2-reorder button:hover:not(:disabled) { background:var(--blue-soft); }
.v2-destination-row .destination-card { display:grid; grid-template-columns:45px 54px minmax(0,1fr); gap:12px; width:100%; border:0; background:transparent; padding:0; min-height:54px; box-shadow:none; }
.v2-destination-row .destination-card.selected { background:transparent; border:0; }
.v2-destination-row .destination-card:hover:not(:disabled) { background:transparent; }
.v2-destination-row .destination-copy { grid-column:3; grid-row:1; }
.v2-destination-row .destination-copy strong { font-size:16px; font-weight:750; }
.v2-destination-row .destination-copy > span { font-size:12px; line-height:1.4; margin-top:4px; }
.v2-destination-row .platform-logo { grid-column:2; grid-row:1; width:47px; height:47px; border:1px solid var(--border); border-radius:11px; background:var(--surface); }
.v2-destination-row .platform-logo svg { width:34px; height:34px; }
.v2-destination-row .selection-indicator { grid-column:1; grid-row:1; display:block; width:42px; height:25px; border:0; border-radius:20px; background:var(--bg-4); position:relative; }
