<file path="utils/notionLinkOAuth.js">
const failure = (code = "NOTION_OAUTH_FAILED") => Object.assign(new Error(code), { code });
const text = (value, limit) => typeof value === "string" && value.trim().length > 0 && value.length <= limit;
const uuid = value => typeof value === "string" && /^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$/i.test(value);

export const getNotionLinkConfig = () =>
{
    const { NOTION_CLIENT_ID: clientId, NOTION_CLIENT_SECRET: clientSecret,
        NOTION_REDIRECT_URI: redirectUri, NOTION_API_VERSION: apiVersion } = process.env;
    try
    {
        const url = new URL(redirectUri);
        if (!text(clientId, 256) || /[:\s]/.test(clientId) || !text(clientSecret, 4096) ||
            /[\r\n]/.test(clientSecret) || apiVersion !== "2026-03-11" ||
            url.protocol !== "https:" || url.username || url.password || url.search || url.hash)
        {
            throw new Error();
        }
    }
    catch
    {
        throw failure("NOTION_LINK_UNAVAILABLE");
    }
    return { clientId, clientSecret, redirectUri, apiVersion };
};

export const getNotionLinkAuthUrl = (state, redirectUri) =>
{
    const config = getNotionLinkConfig();
    if (redirectUri !== config.redirectUri)
    {
        throw failure("NOTION_LINK_UNAVAILABLE");
    }
    const url = new URL("https://api.notion.com/v1/oauth/authorize");
    url.search = new URLSearchParams({ client_id: config.clientId, response_type: "code",
        owner: "user", redirect_uri: redirectUri, state }).toString();
    return url.toString();
};

export const validateNotionTokens = (data, { identityRequired = true } = {}) =>
{
    if (!data || typeof data !== "object" || Array.isArray(data) || data.error ||
        !text(data.access_token, 16384) || !text(data.refresh_token, 16384) || data.token_type !== "bearer")
    {
        throw failure();
    }
    if (identityRequired && (!uuid(data.workspace_id) || !uuid(data.bot_id) ||
        data.owner?.type !== "user" || !uuid(data.owner?.user?.id)))
    {
        throw failure();
    }
    for (const key of ["workspace_name", "workspace_icon"])
    {
        if (data[key] != null && (typeof data[key] !== "string" || data[key].length > 2048))
        {
            throw failure();
        }
    }
    return data;
};

const requestTokens = async (body, config, identityRequired) =>
{
    try
    {
        const response = await fetch("https://api.notion.com/v1/oauth/token",
        {
            method: "POST", redirect: "error", signal: AbortSignal.timeout(10000),
            headers:
            {
                Authorization: `Basic ${Buffer.from(`${config.clientId}:${config.clientSecret}`).toString("base64")}`,
                "Content-Type": "application/json", Accept: "application/json", "Notion-Version": config.apiVersion
            },
            body: JSON.stringify(body)
        });
        if (response.status !== 200 || !/^application\/json\b/i.test(response.headers.get("content-type") || ""))
        {
            await response.body?.cancel();
            throw new Error();
        }
        // Bound the decoded stream as well as any advertised length.
        const reader = response.body.getReader();
        const chunks = [];
        let size = 0;
        try
        {
            while (true)
            {
                const { done, value } = await reader.read();
                if (done)
                {
                    break;
                }
                size += value.byteLength;
                if (size > 65536)
                {
                    await reader.cancel();
                    throw new Error();
                }
                chunks.push(Buffer.from(value));
            }
        }
        finally
        {
            reader.releaseLock();
        }
        return validateNotionTokens(JSON.parse(Buffer.concat(chunks).toString("utf8")), { identityRequired });
    }
    catch
    {
        // Raw provider errors, response bodies and transport exceptions never escape.
        throw failure();
    }
};

export const exchangeNotionLinkCode = async (code, redirectUri) =>
{
    const config = getNotionLinkConfig();
    if (redirectUri !== config.redirectUri)
    {
        throw failure("NOTION_LINK_UNAVAILABLE");
    }
    return requestTokens({ grant_type: "authorization_code", code, redirect_uri: redirectUri }, config, true);
};

export const refreshNotionTokens = async refreshToken =>
{
    const config = getNotionLinkConfig();
    if (!text(refreshToken, 16384))
    {
        throw failure();
    }
    return requestTokens({ grant_type: "refresh_token", refresh_token: refreshToken }, config, false);
};
</file>

<file path="utils/providerTokenEncryption.js">
import { createCipheriv, createDecipheriv, randomBytes } from "node:crypto";

const configurationError = () =>
{
    const error = new Error("Provider token encryption is not configured correctly");
    error.statusCode = 503;
    error.code = "TOKEN_ENCRYPTION_UNAVAILABLE";
    return error;
};

const readKeys = () =>
{
    try
    {
        const keys = JSON.parse(process.env.PROVIDER_TOKEN_KEYS || "null");
        const activeKeyId = process.env.PROVIDER_TOKEN_ACTIVE_KEY_ID;
        if (!keys || Array.isArray(keys) || typeof keys !== "object" ||
            !/^[A-Za-z0-9_-]{1,64}$/.test(activeKeyId || "") ||
            !Object.hasOwn(keys, activeKeyId))
        {
            throw configurationError();
        }
        for (const [id, key] of Object.entries(keys))
        {
            if (!/^[A-Za-z0-9_-]{1,64}$/.test(id) || typeof key !== "string" || !/^[a-fA-F0-9]{64}$/.test(key))
            {
                throw configurationError();
            }
        }
        return { keys, activeKeyId };
    }
    catch
    {
        throw configurationError();
    }
};

const aad = (keyId, context) =>
{
    if (!context || typeof context.userId !== "string" || !context.userId ||
        typeof context.provider !== "string" || !context.provider ||
        !["access", "refresh"].includes(context.tokenType))
    {
        throw new Error("Provider token encryption context is required");
    }
    return Buffer.from(JSON.stringify(["provider-token", "v1", keyId,
        context.userId, context.provider, context.tokenType]));
};

export const assertTokenEncryptionConfigured = () =>
{
    readKeys();
};

export const encryptProviderToken = (token, context) =>
{
    if (typeof token !== "string" || !token.trim() || token.length > 16384)
    {
        throw new Error("Invalid provider token");
    }
    const { keys, activeKeyId } = readKeys();
    const iv = randomBytes(12);
    const cipher = createCipheriv("aes-256-gcm", Buffer.from(keys[activeKeyId], "hex"), iv);
    cipher.setAAD(aad(activeKeyId, context));
    const ciphertext = Buffer.concat([cipher.update(token, "utf8"), cipher.final()]);
    return {
        encryptedToken: ["v1", activeKeyId, iv.toString("hex"),
            cipher.getAuthTag().toString("hex"), ciphertext.toString("base64url")].join("."),
        keyId: activeKeyId
    };
};

export const decryptProviderToken = (encryptedToken, context) =>
{
    try
    {
        if (typeof encryptedToken !== "string" || encryptedToken.length > 33000)
        {
            throw new Error();
        }
        const [version, keyId, iv, tag, ciphertext, extra] = encryptedToken.split(".");
        const { keys } = readKeys();
        if (version !== "v1" || extra !== undefined || !Object.hasOwn(keys, keyId) ||
            !/^[a-f0-9]{24}$/.test(iv || "") || !/^[a-f0-9]{32}$/.test(tag || "") ||
            !/^[A-Za-z0-9_-]+$/.test(ciphertext || ""))
        {
            throw new Error();
        }
        if (Buffer.from(ciphertext, "base64url").toString("base64url") !== ciphertext)
        {
            throw new Error();
        }
        const decipher = createDecipheriv("aes-256-gcm", Buffer.from(keys[keyId], "hex"), Buffer.from(iv, "hex"));
        decipher.setAAD(aad(keyId, context));
        decipher.setAuthTag(Buffer.from(tag, "hex"));
        return Buffer.concat([decipher.update(Buffer.from(ciphertext, "base64url")), decipher.final()]).toString("utf8");
    }
    catch
    {
        const error = new Error("Provider token could not be decrypted");
        error.code = "TOKEN_DECRYPTION_FAILED";
        error.statusCode = 503;
        throw error;
    }
};
</file>

<file path="utils/telegramBot.js">
import TelegramBot from 'node-telegram-bot-api';
import Settings from '../Models/User.js';

const bot = new TelegramBot(process.env.TELEGRAM_BOT_TOKEN);

export const startTelegramBot = async () =>
{
    try
    {
        console.log('[TELEGRAM] Starting Telegram bot...');
        
        // Set Webhook
        const webhookSecret = process.env.TELEGRAM_WEBHOOK_SECRET;

        if (!webhookSecret || !/^[A-Za-z0-9_-]{1,256}$/.test(webhookSecret))
        {
            throw new Error("TELEGRAM_WEBHOOK_SECRET is missing or invalid");
        }

        const webhookUrl = `${process.env.WEBHOOK_URL}/api/v1/telegram/webhook`;

        await bot.setWebHook(webhookUrl,
        {
            secret_token: webhookSecret
        });
        console.log('[TELEGRAM] Webhook set:', webhookUrl);

        // /start command - handle deep link and manual commands
        bot.onText(/\/start (.+)/, async (msg, match) =>
        {
            const chatId = msg.chat.id;
            const userId = match[1].trim();
            
            console.log('[TELEGRAM] === START COMMAND ===');
            console.log('[TELEGRAM] User ID received:', userId);
            console.log('[TELEGRAM] Chat ID:', chatId);

            try
            {
                const user = await Settings.findOne({ userId });

                if (!user)
                {
                    console.log('[TELEGRAM] User not found:', userId);
                    await bot.sendMessage(chatId,
                        ` Invalid User ID: ${userId}\n\n` +
                        `Please open the extension and copy your correct User ID.\n\n` +
                        `Your User ID should look like: USER_1234567890\n\n` +
                        `Get your User ID from extension settings.`
                    );
                    return;
                }

                console.log('[TELEGRAM] User found, updating connection...');
                
                // Update user with Telegram connection
                user.telegramChatId = chatId.toString();
                user.receiveTelegramQuiz = true;
                user.telegramConnected = true;

                await user.save();

                console.log('[TELEGRAM] Connection saved successfully');
                console.log('[TELEGRAM] User ID:', userId);
                console.log('[TELEGRAM] Chat ID:', chatId);
                console.log('[TELEGRAM] Connected:', user.telegramConnected);
                console.log('[TELEGRAM] Quiz enabled:', user.receiveTelegramQuiz);
                
                await bot.sendMessage(chatId,
                    ` Successfully connected!\n\n` +
                    ` Your TickTick extension is now linked to Telegram.\n` +
                    ` You'll receive weekly quizzes every Sunday.\n` +
                    ` You can interact with your saved articles here.\n\n` +
                    `User ID: ${userId}\n\n` +
                    `Good luck! `
                );

                console.log(`[TELEGRAM] User ${userId} connected with chatId ${chatId}`);
                console.log('[TELEGRAM] === CONNECTION COMPLETE ===');
            }
            catch (error)
            {
                console.error('[TELEGRAM] Error:', error.message);
                await bot.sendMessage(chatId,
                    " Something went wrong. Please try again later."
                );
            }
        });

        // /start without userId
        bot.onText(/\/start$/, async (msg) =>
        {
            console.log('[TELEGRAM] Message received without userId');
            const chatId = msg.chat.id;
            await bot.sendMessage(chatId,
                ` Please start with your User ID:\n\n` +
                `/start YOUR_USER_ID\n\n` +
                `Example: /start USER_123\n\n` +
                `Get your User ID from the extension settings.`
            );
        });

        // Handle any message for debugging
        bot.on('message', (msg) => {
            console.log('[TELEGRAM] Debug message:', msg.text, 'from chat:', msg.chat.id);
        });

        console.log('[TELEGRAM] Bot started successfully');
    }
    catch (error)
    {
        console.error('[TELEGRAM] Failed to start bot:', error.message);
    }
};

export default bot;
