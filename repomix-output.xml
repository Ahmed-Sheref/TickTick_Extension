<file path="utils/ticktickCredentialFingerprint.js">
import { createHmac } from "node:crypto";

const configurationError = () =>
{
    const error = new Error("TickTick credential fingerprinting is not configured correctly");
    error.code = "TICKTICK_FINGERPRINT_UNAVAILABLE";
    error.statusCode = 503;
    return error;
};

const readKey = () =>
{
    const key = process.env.TICKTICK_CREDENTIAL_FINGERPRINT_KEY;
    if (typeof key !== "string" || !/^[a-fA-F0-9]{64}$/.test(key))
    {
        throw configurationError();
    }
    const reused = value => typeof value === "string" && value.toLowerCase() === key.toLowerCase();
    const otherSecrets = ["JWT_SECRET", "TICKTICK_CLIENT_SECRET", "TICKTICK_LINK_CLIENT_SECRET", "GOOGLE_CLIENT_SECRET"];
    if (otherSecrets.some(name => reused(process.env[name])))
    {
        throw configurationError();
    }
    // Check known encryption-key reuse without coupling fingerprinting to the
    // encryption configuration parser. AES configuration is validated separately.
    let encryptionKeys;
    try
    {
        encryptionKeys = JSON.parse(process.env.PROVIDER_TOKEN_KEYS || "{}");
    }
    catch
    {
        encryptionKeys = {};
    }
    if (encryptionKeys && typeof encryptionKeys === "object" && Object.values(encryptionKeys).some(reused))
    {
        throw configurationError();
    }
    return Buffer.from(key, "hex");
};

export const assertTickTickFingerprintConfigured = () =>
{
    readKey();
};

// Identifies an exact issued credential only, never a permanent provider user.
export const fingerprintTickTickCredential = (accessToken) =>
{
    const key = readKey();
    if (typeof accessToken !== "string" || !accessToken.trim() || accessToken.length > 16384)
    {
        throw new Error("Invalid TickTick credential");
    }
    return createHmac("sha256", key).update(accessToken, "utf8").digest("hex");
};
</file>

<file path="utils/ticktickLinkOAuth.js">
const oauthError = (message, statusCode = 502, code = "TICKTICK_OAUTH_FAILED") =>
{
    const error = new Error(message);
    error.statusCode = statusCode;
    error.code = code;
    return error;
};

export const getTickTickLinkConfig = () =>
{
    const dedicatedClient = Boolean(process.env.TICKTICK_LINK_CLIENT_ID || process.env.TICKTICK_LINK_CLIENT_SECRET);
    const clientId = dedicatedClient ? process.env.TICKTICK_LINK_CLIENT_ID : process.env.TICKTICK_CLIENT_ID;
    const clientSecret = dedicatedClient ? process.env.TICKTICK_LINK_CLIENT_SECRET : process.env.TICKTICK_CLIENT_SECRET;
    const redirectUri = process.env.TICKTICK_LINK_REDIRECT_URI;
    try
    {
        const url = new URL(redirectUri);
        if (!clientId || !clientSecret || url.username || url.password || url.search || url.hash ||
            (url.protocol !== "https:" && !(url.protocol === "http:" && ["localhost", "127.0.0.1"].includes(url.hostname))))
        {
            throw new Error();
        }
    }
    catch
    {
        throw oauthError("TickTick linking is not configured", 503, "TICKTICK_LINK_UNAVAILABLE");
    }
    return { clientId, clientSecret, redirectUri };
};

export const getTickTickLinkAuthUrl = (state, redirectUri) =>
{
    const config = getTickTickLinkConfig();
    if (redirectUri !== config.redirectUri)
    {
        throw oauthError("TickTick linking configuration changed; start again", 400);
    }
    const url = new URL("https://ticktick.com/oauth/authorize");
    url.search = new URLSearchParams({ client_id: config.clientId, redirect_uri: redirectUri,
        response_type: "code", scope: "tasks:read tasks:write", state }).toString();
    return url.toString();
};

export const exchangeTickTickLinkCode = async (code, redirectUri) =>
{
    const config = getTickTickLinkConfig();
    if (config.redirectUri !== redirectUri)
    {
        throw oauthError("TickTick linking configuration changed; start again", 400);
    }
    try
    {
        const response = await fetch("https://ticktick.com/oauth/token",
        {
            method: "POST",
            redirect: "error",
            signal: AbortSignal.timeout(10000),
            headers:
            {
                Authorization: `Basic ${Buffer.from(`${config.clientId}:${config.clientSecret}`).toString("base64")}`,
                "Content-Type": "application/x-www-form-urlencoded"
            },
            body: new URLSearchParams({ code, grant_type: "authorization_code", redirect_uri: redirectUri })
        });
        if (!response.ok)
        {
            throw new Error();
        }
        const data = await response.json();
        if (typeof data.access_token !== "string" || !data.access_token.trim() || data.access_token.length > 16384 ||
            (data.refresh_token != null && (typeof data.refresh_token !== "string" || data.refresh_token.length > 16384)) ||
            (data.token_type && data.token_type.toLowerCase() !== "bearer"))
        {
            throw new Error();
        }
        return data;
    }
    catch
    {
        // Never propagate provider response bodies, headers, or fetch exceptions.
        throw oauthError("TickTick authorization code exchange failed");
    }
};
</file>

<file path="validators/contentDestinations.js">
import
{
    notionId
}
from "./notionValidator.js";

export const invalidDestination = message => Object.assign(new Error(message),
{
    statusCode: 400
});
const object = value => value && typeof value === "object" && !Array.isArray(value);
const keys = (value, allowed) => object(value) && Object.keys(value).every(key => allowed.includes(key));

// Omitted intent is deliberately library-only, including requests from old clients.
export function contentDestinations(payload)
{
    if (["accessToken", "refreshToken", "access_token", "refresh_token", "workspaceId", "providerAccountId"].some(key => Object.hasOwn(payload, key)))
        throw invalidDestination("Provider credentials and identities are not accepted");
    if (payload.destinations !== undefined && !object(payload.destinations)) throw invalidDestination("Invalid destinations");
    const input = payload.destinations ??
    {};
    if (!keys(input, ["ticktick", "notion"])) throw invalidDestination("Unsupported content destinations");
    const result = {};
    for (const provider of ["ticktick", "notion"])
    {
        const value = input[provider] === undefined ?
        {
            enabled: false
        } : input[provider];
        const allowed = provider === "ticktick" ? ["enabled", "projectId"] : ["enabled", "destinationId", "destinationType"];
        if (!keys(value, allowed) || typeof value.enabled !== "boolean") throw invalidDestination(`Invalid ${provider} selection`);
        if (!value.enabled && Object.keys(value).some(key => key !== "enabled")) throw invalidDestination(`Options require ${provider} selection`);
        result[provider] = {
            enabled: value.enabled
        };
        if (provider === "ticktick" && value.enabled)
        {
            const projectId = value.projectId ?? payload.projectId ?? null;
            if (typeof projectId !== "string" || !/^[a-zA-Z0-9_-]{1,100}$/.test(projectId)) throw invalidDestination("Choose a TickTick list before saving");
            result.ticktick.projectId = projectId;
        }
        if (provider === "notion" && value.enabled && (value.destinationId !== undefined || value.destinationType !== undefined))
        {
            if (!notionId(value.destinationId) || !["page", "data_source"].includes(value.destinationType)) throw invalidDestination("Invalid Notion destination");
            Object.assign(result.notion,
            {
                id: notionId(value.destinationId),
                type: value.destinationType
            });
        }
    }
    if (payload.ticktickOptions !== undefined && (!result.ticktick.enabled || !keys(payload.ticktickOptions, ["useAiSummary", "useAiTags", "mergeSummaryWithContent", "tags"])))
        throw invalidDestination("Invalid TickTick options");
    const options = payload.ticktickOptions ??
    {};
    for (const key of ["useAiSummary", "useAiTags", "mergeSummaryWithContent"])
        if (options[key] !== undefined && typeof options[key] !== "boolean") throw invalidDestination(`Invalid ${key}`);
    if (options.tags !== undefined && (!Array.isArray(options.tags) || options.tags.length > 30 || options.tags.some(tag => typeof tag !== "string" || !tag.trim() || tag.length > 60)))
        throw invalidDestination("Invalid TickTick tags");
    result.ticktick.options = {
        useAiSummary: options.useAiSummary ?? false,
        useAiTags: options.useAiTags ?? false,
        mergeSummaryWithContent: options.mergeSummaryWithContent ?? false,
        tags: options.tags ?? []
    };
    return result;
}
</file>

<file path="validators/notionValidator.js">
import
{
    notionFailure
}
from "../utils/notionErrors.js";

export const notionId = value =>
{
    if (typeof value !== "string") return null;
    const compact = value.replaceAll("-", "");
    if (!/^[a-f0-9]{32}$/i.test(compact) ||
        !(/^[a-f0-9]{32}$/i.test(value) || /^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$/i.test(value))) return null;
    return compact.toLowerCase().replace(/^(.{8})(.{4})(.{4})(.{4})(.{12})$/, "$1-$2-$3-$4-$5");
};

export const destinationInput = body =>
{
    if (!body || typeof body !== "object" || Array.isArray(body) ||
        Object.keys(body).some(key => !["destinationId", "destinationType"].includes(key)) || !notionId(body.destinationId))
        throw notionFailure("INVALID_NOTION_INPUT");
    if (!["page", "data_source", "database"].includes(body.destinationType))
        throw notionFailure("NOTION_DESTINATION_UNSUPPORTED");
    return {
        id: notionId(body.destinationId),
        type: body.destinationType
    };
};

export const searchInput = (
{
    query,
    cursor,
    ...extra
} = {}) =>
{
    if (Object.keys(extra).length || (query !== undefined &&
            (typeof query !== "string" || query.length > 200 || /[\u0000-\u001f]/.test(query))) ||
        (cursor !== undefined && !notionId(cursor))) throw notionFailure("INVALID_NOTION_INPUT");
    return {
        ...(query?.trim() ?
        {
            query: query.trim()
        } :
        {}),
        ...(cursor ?
        {
            start_cursor: notionId(cursor)
        } :
        {}),
        page_size: 50
    };
};

export const contentIdInput = value =>
{
    if (typeof value !== "string" || !/^[a-f0-9]{24}$/i.test(value)) throw notionFailure("INVALID_NOTION_INPUT");
    return value.toLowerCase();
};
</file>

<file path="API_DOCUMENTATION.md">
# Knowvia API

The maintained executable contract is [swagger/UI/swagger-ui.js](swagger/UI/swagger-ui.js), served at `/api-docs`, `/api-docs.json`, and `/api-docs/health`. Existing API documentation version **2.2.0** is retained; package version is a separate convention.

## Authentication
Google application login starts at `GET /api/v1/auth/google/auth` (also `/api/v1/auth/google`). Supply an allowlisted `redirect_uri`, a 32–128 character base64url `client_nonce`, and the hexadecimal SHA-256 `code_challenge` of the extension verifier. The state-bound callback returns a short-lived exchange code. POST `exchange_code` and the 64-character hexadecimal `verifier` to `/api/v1/auth/google/exchange` to receive the application JWT. Send it as `Authorization: Bearer …` for authenticated operations.

Authenticated `POST /api/v1/integrations/ticktick/link` and `/api/v1/integrations/notion/link` accept `redirect_uri` and `client_nonce`, returning `data.authorizationUrl`. Their callbacks validate saved state, require no bearer header, and never return provider tokens. These optional connections do not establish application identity. `/api/v1/ticktick/auth`, `/callback`, and `/auth/exchange` remain legacy compatibility routes.

## Content workflow
`POST /api/v1/content` requires title and rawText, with maximum lengths 500 and 100000. Ownership comes from JWT. Global tags are parsed from `user_input` hashtags. Omitted destinations disable both exports, regardless of connected accounts. Swagger supplies four examples: Knowvia only, TickTick only, Notion only, and both; example provider IDs must be replaced with verified selections.

Input validation and connection metadata checks precede the MongoDB transaction. External writes dispatch independently after commit. HTTP 201 confirms primary persistence, not external success. In-process dispatch is best effort and not durable. TickTick AI affects only its copy; original content is preserved. Explicit destinations disable legacy primary summary/tag AI flags. `use_quiz` retains backend compatibility; the current frontend explicitly sends false.

`GET /api/v1/content/{contentId}/sync-status` is owner-scoped and read-only. Providers independently report not_requested, queued, pending, synced, failed or uncertain; Notion can also report partial. Notion queued can be projected from selected intent before an attempt exists. Only confirmed external references are exposed, never claim values or credentials.

Retries use persisted selection, not arbitrary new options: `POST /api/v1/content/{contentId}/sync/ticktick` and `POST /api/v1/integrations/notion/sync/{contentId}` accept no body (an empty object is also accepted). They do not create another primary Content. Conditional claims prevent concurrent duplication; pending and uncertain outcomes are not blindly retried. Notion resumes only definite partial failures with safe recorded progress and matching binding. Retries are not a universal exactly-once guarantee.

## Notion destinations
GET `/api/v1/integrations/notion/destinations` supports bounded search (`query`) and cursor pagination. GET/PUT/DELETE `/destination` reads, verifies/selects, or clears a default. The default is bound to connection/selection metadata. A per-save selection does not silently change it. Selection accepts a database alias only when it resolves unambiguously to one data source; content request selection uses canonical page/data_source types. Page/block export needs write permissions and a supported schema. Arbitrary database property mapping and attachment uploads are unsupported.

## Account and delivery
The exact case-sensitive documented prefix is `/api/v1/User`: POST `/email`, POST `/quiz-preferences`, GET `/preferences/me`. All require application JWT and derive ownership from it. These supported APIs remain available in Swagger while extension Email/Telegram controls are hidden. Previously enabled scheduled delivery can remain active. Account owners can explicitly change preferences through these authenticated endpoints; a separate supported account-management UI is a follow-up, not silently implemented here.

POST `/api/v1/telegram/webhook` is server-to-server and uses `X-Telegram-Bot-Api-Secret-Token`, not application JWT.

## Limits
No attachment upload, TickTick due-date/priority override, arbitrary Notion property mapping, or durable export queue is promised. Live provider acceptance requires configured accounts. `api-docs.js` is an unmounted legacy reference, not the public contract.
</file>

